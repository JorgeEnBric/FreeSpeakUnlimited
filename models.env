# Ubicaciones de los modelos usados por FreeSpeak Unlimited
# Las rutas son relativas a la raíz del proyecto. Se pueden sobreescribir
# con variables de entorno del sistema (tienen prioridad) o con rutas absolutas.

# Directorio base de modelos (por defecto src/models)
MODELS_DIR=src/models

# Piper TTS
PIPER_EXE=src/models/piper/dist/piper/piper.exe
PIPER_VOICE_MODEL=src/models/en_US-lessac-medium.onnx

# Whisper (STT)
WHISPER_CLI=src/models/whisper-bin-x64/whisper-cli.exe
WHISPER_MODEL=src/models/ggml-base.bin

# llama-server (LLM persistente)
LLAMA_SERVER_EXE=src/models/llama-b10182-bin-win-cpu-x64/llama-server.exe

# llama-cli (fallback LLM; un nombre de archivo desnudo se buscará en el PATH del sistema)
LLAMA_CLI=src/models/llama-b10182-bin-win-cpu-x64/llama-cli.exe

# Modelo LLM (Gemma). Si no se define, se busca en el directorio de modelos.
GEMMA_MODEL=src/models/gemma-2-2b-it-q4_k_m/gemma-2-2b-it-q4_k_m.gguf
