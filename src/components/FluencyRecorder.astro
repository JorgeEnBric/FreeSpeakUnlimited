---
---

<div class="recorder-container">
  <button id="fluency-record-btn" class="record-button" aria-label="Record fluency">
    <svg id="fluency-mic-icon" class="mic-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
      <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
      <line x1="12" y1="19" x2="12" y2="23"></line>
      <line x1="8" y1="23" x2="16" y2="23"></line>
    </svg>
    <svg id="fluency-stop-icon" class="stop-icon hidden" viewBox="0 0 24 24" fill="currentColor">
      <rect x="6" y="6" width="12" height="12" rx="2"></rect>
    </svg>
  </button>
  <div class="recorder-actions">
    <p id="fluency-status" class="status">Click to start recording</p>
    <button id="fluency-pause-btn" class="pause-button hidden" aria-label="Pause recording">Pause</button>
    <button id="fluency-cancel-btn" class="cancel-button hidden" aria-label="Cancel recording">Cancel</button>
  </div>

  <div id="fluency-transcript-modal" class="transcript-modal hidden">
    <div class="transcript-box">
      <h3 class="transcript-title">Your speech</h3>
      <p class="transcript-hint">Review transcript. Correct if needed and press Send. Recording auto-stops at 2:00.</p>
      <div id="fluency-transcript-edit" class="transcript-edit" contenteditable="true" role="textbox" aria-multiline="false" spellcheck="false"></div>
      <div id="fluency-suggest-pop" class="suggest-pop hidden">
        <span class="suggest-label">Suggestion:</span>
        <button id="fluency-suggest-insert" class="suggest-insert" type="button">…</button>
      </div>
      <div class="transcript-actions">
        <button id="fluency-transcript-replay" class="transcript-btn ghost replay" type="button">&#9654; Listen to audio</button>
        <button id="fluency-transcript-cancel" class="transcript-btn ghost" type="button">Discard</button>
        <button id="fluency-transcript-confirm" class="transcript-btn" type="button">Send</button>
      </div>
    </div>
  </div>
</div>

<script>
  import { createPhaseController } from '../lib/statusPhase';

  let mediaRecorder = null;
  let mediaStream = null;
  let audioChunks = [];
  let isRecording = false;
  let isPaused = false;
  let isCancelled = false;
  let recordingStart = 0;
  let pausedAccum = 0;
  let recordingTimer = null;
  let recordingDurationMs = 0;
  let fluencyHistory = [];
  let audioCtx = null;
  let nextPlayTime = 0;
  let activeSources = [];
  let currentChatAbort = null;

  const recordBtn = document.getElementById('fluency-record-btn');
  const pauseBtn = document.getElementById('fluency-pause-btn');
  const cancelBtn = document.getElementById('fluency-cancel-btn');
  const micIcon = document.getElementById('fluency-mic-icon');
  const stopIcon = document.getElementById('fluency-stop-icon');
  const status = document.getElementById('fluency-status');
  const chatDisplay = document.getElementById('fluency-chat');
  const topicEl = document.getElementById('fluency-topic-text');

  const phase = createPhaseController(() => status, 'Click to start recording', () => isRecording);

  window.addEventListener('analysis-phase', (event) => {
    const detail = (event as CustomEvent).detail;
    if (detail) phase.handlePoll(detail);
  });

  function getCurrentTopic() {
    const el = document.getElementById('fluency-topic-text');
    return el ? el.textContent.trim() : '';
  }

  function addMessage(type, text, empty = false) {
    if (!chatDisplay) return null;
    const messageDiv = document.createElement('div');
    messageDiv.className = `message ${type}`;
    const replayBtn = type === 'assistant' ? `<button class="replay-btn" aria-label="Replay audio">&#9654;</button>` : '';
    const avatar = type === 'assistant' ? `<div class="avatar">AI</div>` : '';
    messageDiv.innerHTML = `
      ${avatar}
      <div class="content">
        <p>${empty ? '' : text}</p>
      </div>
      ${replayBtn}
    `;
    if (type === 'assistant') {
      const btn = messageDiv.querySelector('.replay-btn');
      btn?.addEventListener('click', () => {
        const p = messageDiv.querySelector('p');
        const t = p ? p.textContent : text;
        if (t) replayText(t, btn);
      });
    }
    chatDisplay.prepend(messageDiv);
    return messageDiv;
  }

  // Historial sin persistencia para debate continuo
  window.addEventListener('fluency-new-topic', () => {
    fluencyHistory = [];
    if (chatDisplay) chatDisplay.innerHTML = '';
    phase.reset();
  });

  function initAudioCtx() {
    if (!audioCtx) {
      const Ctx = window.AudioContext || window.webkitAudioContext;
      audioCtx = new Ctx();
    }
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  }

  function resetAudioPlayback() { nextPlayTime = 0; activeSources = []; }
  function stopAudioPlayback() {
    if (currentChatAbort) { currentChatAbort.abort(); currentChatAbort = null; }
    for (const src of activeSources) { try { src.stop(); } catch {} }
    activeSources = []; nextPlayTime = 0;
  }
  function playPcmChunk(b64) {
    try {
      const ctx = initAudioCtx();
      const binary = atob(b64);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
      const int16 = new Int16Array(bytes.buffer);
      const float32 = new Float32Array(int16.length);
      for (let i = 0; i < int16.length; i++) float32[i] = int16[i] / 32768;
      const buffer = ctx.createBuffer(1, float32.length, 22050);
      buffer.copyToChannel(float32, 0);
      const src = ctx.createBufferSource();
      src.buffer = buffer;
      src.connect(ctx.destination);
      const now = ctx.currentTime;
      if (nextPlayTime < now) nextPlayTime = now + 0.02;
      src.start(nextPlayTime);
      nextPlayTime += buffer.duration;
      activeSources.push(src);
      src.onended = () => { const idx = activeSources.indexOf(src); if (idx !== -1) activeSources.splice(idx, 1); };
      if (status) status.textContent = 'Speaking...';
    } catch (e) { console.error('Audio playback error:', e); }
  }

  let audioCache = new Map();
  function getAudioEl(text) {
    return new Promise((resolve, reject) => {
      const cached = audioCache.get(text);
      if (cached) { resolve(cached); return; }
      fetch('/api/tts', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) })
        .then(async (res) => {
          if (!res.ok) throw new Error('TTS failed');
          const blob = await res.blob();
          const url = URL.createObjectURL(blob);
          const audioEl = new Audio(url);
          audioCache.set(text, audioEl);
          resolve(audioEl);
        }).catch(reject);
    });
  }
  function replayText(text, btn) {
    const trimmed = text.trim(); if (!trimmed) return;
    btn.classList.add('playing');
    getAudioEl(trimmed).then((audioEl) => {
      if (status) status.textContent = 'Speaking...';
      audioEl.onended = () => { btn.classList.remove('playing'); if (phase.isActive()) phase.refresh(); else if (status) status.textContent = 'Click to start recording'; };
      return audioEl.play();
    }).catch((e) => { console.error(e); btn.classList.remove('playing'); });
  }

  function formatTimer(ms) {
    const totalSec = Math.floor(ms / 1000);
    const m = String(Math.floor(totalSec / 60)).padStart(2, '0');
    const s = String(totalSec % 60).padStart(2, '0');
    return `${m}:${s}`;
  }

  function updateRecordingTimer() {
    if (!isRecording || isPaused) return;
    const elapsed = pausedAccum + (Date.now() - recordingStart);
    recordingDurationMs = elapsed;
    const cls = elapsed < 120000 ? 'valid' : 'over';
    if (status) {
      status.innerHTML = `<span id="fluency-timer" class="fluency-timer ${cls}">${formatTimer(elapsed)}</span> Recording (${Math.floor(elapsed / 1000)}s / 120s)`;
    }
    if (elapsed >= 120000) {
      // Límite duro: detener grabación automáticamente y continuar al modal
      stopRecording();
    }
  }

  async function startRecording() {
    try {
      mediaStream = await navigator.mediaDevices.getUserMedia({ audio: true });
      audioChunks = [];
      mediaRecorder = new MediaRecorder(mediaStream, { mimeType: 'audio/webm' });

      mediaRecorder.ondataavailable = (event) => {
        if (event.data.size > 0) audioChunks.push(event.data);
      };

      mediaRecorder.onstop = async () => {
        if (mediaStream) mediaStream.getTracks().forEach(track => track.stop());
        if (recordingTimer) { clearInterval(recordingTimer); recordingTimer = null; }
        if (isCancelled) {
          isCancelled = false;
          isPaused = false;
          pausedAccum = 0;
          recordingDurationMs = 0;
          if (status) status.textContent = 'Recording cancelled';
          updateUI();
          return;
        }
        const duration = pausedAccum + (isPaused ? 0 : (Date.now() - recordingStart));
        recordingDurationMs = duration;
        const audioBlob = new Blob(audioChunks, { type: 'audio/webm' });
        if (audioBlob.size > 0) await processAudio(audioBlob, duration);
        isPaused = false;
        pausedAccum = 0;
      };

      mediaRecorder.start(1000);
      isRecording = true;
      isPaused = false;
      pausedAccum = 0;
      recordingStart = Date.now();
      recordingDurationMs = 0;
      if (status) status.innerHTML = '<span id="fluency-timer" class="fluency-timer valid">00:00</span> Recording (0s / 120s)';
      recordingTimer = setInterval(updateRecordingTimer, 200);
      updateUI();
    } catch (error) {
      const msg = error instanceof Error ? error.message : 'Unknown error';
      if (status) status.textContent = `Microphone error: ${msg}`;
      console.error('Error accessing microphone:', error);
    }
  }

  function stopRecording() {
    if (mediaRecorder && isRecording) {
      if (recordingTimer) { clearInterval(recordingTimer); recordingTimer = null; }
      mediaRecorder.stop();
      isRecording = false;
      updateUI();
    }
  }

  function pauseRecording() {
    if (mediaRecorder && isRecording && !isPaused && mediaRecorder.state === 'recording') {
      mediaRecorder.pause();
      isPaused = true;
      pausedAccum += Date.now() - recordingStart;
      if (recordingTimer) { clearInterval(recordingTimer); recordingTimer = null; }
      if (status) status.innerHTML = `<span id="fluency-timer" class="fluency-timer">${formatTimer(pausedAccum)}</span> Pausado (${Math.floor(pausedAccum/1000)}s)`;
      updateUI();
    }
  }

  function resumeRecording() {
    if (mediaRecorder && isRecording && isPaused && mediaRecorder.state === 'paused') {
      mediaRecorder.resume();
      isPaused = false;
      recordingStart = Date.now();
      recordingTimer = setInterval(updateRecordingTimer, 200);
      updateUI();
    }
  }

  function cancelRecording() {
    if (mediaRecorder && isRecording) {
      isCancelled = true;
      if (recordingTimer) { clearInterval(recordingTimer); recordingTimer = null; }
      phase.reset();
      mediaRecorder.stop();
      isRecording = false;
      isPaused = false;
      updateUI();
    }
  }

  function updateUI() {
    if (isRecording) {
      micIcon?.classList.add('hidden');
      stopIcon?.classList.remove('hidden');
      recordBtn.classList.add('recording');
      cancelBtn?.classList.remove('hidden');
      pauseBtn?.classList.remove('hidden');
      if (isPaused) {
        pauseBtn.textContent = 'Resume';
        pauseBtn.classList.add('paused');
        recordBtn.classList.add('paused');
      } else {
        pauseBtn.textContent = 'Pause';
        pauseBtn.classList.remove('paused');
        recordBtn.classList.remove('paused');
      }
    } else {
      micIcon?.classList.remove('hidden');
      stopIcon?.classList.add('hidden');
      recordBtn.classList.remove('recording', 'paused');
      cancelBtn?.classList.add('hidden');
      pauseBtn?.classList.add('hidden');
      pauseBtn.classList.remove('paused');
    }
  }

  function escapeHtml(text) {
    return String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
  }

  function normalizeWord(word) {
    return String(word).toLowerCase().replace(/[^a-z']/g, '');
  }

  function highlightTranscription(text, uncertainWords) {
    const uncertain = new Set((uncertainWords || []).map(normalizeWord));
    return String(text).split(/(\s+)/).map((part) => {
      if (!/\S/.test(part)) return escapeHtml(part);
      const clean = normalizeWord(part);
      if (clean && uncertain.has(clean)) {
        return `<span class="doubt" data-word="${escapeHtml(clean)}">${escapeHtml(part)}</span>`;
      }
      return escapeHtml(part);
    }).join('');
  }

  const transcriptModal = document.getElementById('fluency-transcript-modal');
  const transcriptEdit = document.getElementById('fluency-transcript-edit');
  const transcriptConfirmBtn = document.getElementById('fluency-transcript-confirm');
  const transcriptCancelBtn = document.getElementById('fluency-transcript-cancel');
  const suggestPop = document.getElementById('fluency-suggest-pop');
  const suggestInsertBtn = document.getElementById('fluency-suggest-insert');

  let currentDoubtSpans = [];
  let suggestActive = false;
  let suggestedWord = '';
  let suggestionReqId = 0;
  let suppressInput = false;

  function getCaretOffset() {
    const sel = window.getSelection();
    if (!sel || sel.rangeCount === 0) return null;
    const range = sel.getRangeAt(0);
    if (!transcriptEdit.contains(range.startContainer)) return null;
    const pre = range.cloneRange();
    pre.selectNodeContents(transcriptEdit);
    pre.setEnd(range.startContainer, range.startOffset);
    return pre.toString().length;
  }

  function setCaretToOffset(offset) {
    const sel = window.getSelection();
    if (!sel) return;
    const node = transcriptEdit;
    const walker = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, null);
    let current = 0;
    while (walker.nextNode()) {
      const textNode = walker.currentNode;
      const len = textNode.textContent.length;
      if (current + len >= offset) {
        const range = document.createRange();
        range.setStart(textNode, Math.min(offset - current, len));
        range.collapse(true);
        sel.removeAllRanges();
        sel.addRange(range);
        return;
      }
      current += len;
    }
    const range = document.createRange();
    range.selectNodeContents(node);
    range.collapse(false);
    sel.removeAllRanges();
    sel.addRange(range);
  }

  function placeSuggestPop() {
    if (!suggestPop) return;
    const box = transcriptModal?.querySelector('.transcript-box');
    if (!box) return;
    const sel = window.getSelection();
    const rect = sel && sel.rangeCount ? sel.getRangeAt(0).getBoundingClientRect() : null;
    const boxRect = box.getBoundingClientRect();
    const popRect = suggestPop.getBoundingClientRect();
    const actionsRow = box.querySelector('.transcript-actions');
    const actionsTop = actionsRow ? actionsRow.getBoundingClientRect().top : boxRect.bottom;
    let left = (rect ? rect.left : boxRect.left) - boxRect.left;
    let top = (rect ? rect.bottom : boxRect.top) - boxRect.top + 8;
    const maxLeft = boxRect.width - 180;
    if (left < 8) left = 8;
    if (left > maxLeft) left = maxLeft;
    if (top + popRect.height + 8 > actionsTop - boxRect.top) {
      top = Math.max(8, (rect ? rect.top : boxRect.top) - boxRect.top - popRect.height - 8);
    }
    suggestPop.style.left = `${left}px`;
    suggestPop.style.top = `${top}px`;
  }

  function hideSuggestPop() {
    suggestActive = false;
    suggestedWord = '';
    if (suggestPop) {
      suggestPop.classList.add('hidden');
      const btn = document.getElementById('fluency-suggest-insert');
      if (btn) btn.textContent = '…';
    }
  }

  function insertSuggestedWord() {
    if (!suggestActive || !suggestedWord) return;
    suppressInput = true;
    try { document.execCommand('insertText', false, suggestedWord); } catch (e) { console.error(e); }
    suppressInput = false;
    hideSuggestPop();
  }

  function onTranscriptInput() {
    if (suppressInput) return;
    if (suggestActive) { hideSuggestPop(); return; }
    const removed = currentDoubtSpans.find((s) => !s.isConnected || !s.textContent.trim());
    if (!removed) return;
    currentDoubtSpans = currentDoubtSpans.filter((s) => s !== removed);
    const offset = getCaretOffset();
    if (offset === null) return;
    if (removed.isConnected) removed.remove();
    setCaretToOffset(offset);
    const text = transcriptEdit?.textContent ?? '';
    const before = text[offset - 1];
    const after = text[offset];
    const isGap = (before === undefined || /\s/.test(before)) && (after === undefined || /\s/.test(after));
    if (!isGap) return;
    const withBlank = text.slice(0, offset) + '___' + text.slice(offset);
    suggestActive = true;
    suggestedWord = '';
    suggestionReqId++;
    const reqId = suggestionReqId;
    if (suggestPop) {
      suggestPop.classList.remove('hidden');
      const btn = document.getElementById('fluency-suggest-insert');
      if (btn) btn.textContent = '…';
    }
    placeSuggestPop();
    fetch('/api/suggest-word', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sentence: withBlank }) })
      .then((res) => res.json()).then((data) => {
        if (reqId !== suggestionReqId || !suggestActive) return;
        const word = (data && typeof data.word === 'string' ? data.word : '').trim();
        if (!word) { hideSuggestPop(); return; }
        suggestedWord = word;
        const btn = document.getElementById('fluency-suggest-insert');
        if (btn) btn.textContent = word;
        placeSuggestPop();
      }).catch((error) => { console.error(error); if (reqId === suggestionReqId) hideSuggestPop(); });
  }

  function placeCaretAtPoint(x, y) {
    const sel = window.getSelection();
    if (!sel) return;
    sel.removeAllRanges();
    let range = null;
    if (document.caretRangeFromPoint) range = document.caretRangeFromPoint(x, y);
    else if (document.caretPositionFromPoint) {
      const pos = document.caretPositionFromPoint(x, y);
      if (pos) { range = document.createRange(); range.setStart(pos.offsetNode, pos.offset); range.collapse(true); }
    }
    if (range) sel.addRange(range);
  }

  if (transcriptEdit) transcriptEdit.addEventListener('input', onTranscriptInput);
  if (transcriptEdit) {
    transcriptEdit.addEventListener('click', (e) => {
      const span = e.target.closest('.doubt');
      if (!span || !transcriptEdit.contains(span)) return;
      e.preventDefault();
      const range = document.createRange(); range.selectNodeContents(span);
      const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
    });
    transcriptEdit.addEventListener('dblclick', (e) => {
      const span = e.target.closest('.doubt');
      if (!span || !transcriptEdit.contains(span)) return;
      e.preventDefault(); placeCaretAtPoint(e.clientX, e.clientY);
    });
  }
  if (suggestInsertBtn) {
    suggestInsertBtn.addEventListener('mousedown', (e) => e.preventDefault());
    suggestInsertBtn.addEventListener('click', (e) => { e.preventDefault(); insertSuggestedWord(); });
  }

  function askTranscription(transcription, uncertainWords, audioBlob) {
    return new Promise((resolve) => {
      if (!transcriptModal || !transcriptEdit) { resolve(transcription); return; }
      transcriptEdit.innerHTML = highlightTranscription(transcription, uncertainWords);
      currentDoubtSpans = Array.from(transcriptEdit.querySelectorAll('.doubt'));
      hideSuggestPop();
      transcriptModal.classList.remove('hidden');
      function onConfirm() { cleanup(); resolve(transcriptEdit.textContent.trim()); }
      function onCancel() { cleanup(); resolve(null); }
      function onKeydown(event) {
        if (suggestActive && event.key === 'Tab') { event.preventDefault(); insertSuggestedWord(); return; }
        if (suggestActive && event.key === 'Escape') { event.preventDefault(); hideSuggestPop(); return; }
        if (event.key === 'Enter') { event.preventDefault(); onConfirm(); }
        else if (event.key === 'Escape') { event.preventDefault(); onCancel(); }
      }
      transcriptConfirmBtn?.addEventListener('click', onConfirm);
      transcriptCancelBtn?.addEventListener('click', onCancel);
      transcriptEdit.addEventListener('keydown', onKeydown);
      const replayBtn = document.getElementById('fluency-transcript-replay');
      let audioUrl = null; let audioEl = null; let onReplayClick=null, onReplayPlay=null, onReplayPause=null;
      try {
        if (replayBtn && audioBlob) {
          audioUrl = URL.createObjectURL(audioBlob);
          audioEl = new Audio(audioUrl);
          replayBtn.classList.remove('hidden');
          onReplayClick = () => { if (audioEl.paused) { audioEl.currentTime=0; audioEl.play().catch(e=>console.error(e)); } else audioEl.pause(); };
          onReplayPlay = () => { replayBtn.innerHTML = '&#10074;&#10074; Pause'; };
          onReplayPause = () => { replayBtn.innerHTML = '&#9654; Listen to audio'; };
          audioEl.addEventListener('play', onReplayPlay);
          audioEl.addEventListener('pause', onReplayPause);
          audioEl.addEventListener('ended', onReplayPause);
          replayBtn.addEventListener('click', onReplayClick);
        } else if (replayBtn) replayBtn.classList.add('hidden');
      } catch (error) { console.error(error); }
      function cleanup() {
        transcriptConfirmBtn?.removeEventListener('click', onConfirm);
        transcriptCancelBtn?.removeEventListener('click', onCancel);
        transcriptEdit.removeEventListener('keydown', onKeydown);
        if (replayBtn && audioEl && onReplayClick) {
          audioEl.pause(); audioEl.removeEventListener('play', onReplayPlay); audioEl.removeEventListener('pause', onReplayPause); audioEl.removeEventListener('ended', onReplayPause); replayBtn.removeEventListener('click', onReplayClick);
        }
        if (audioUrl) URL.revokeObjectURL(audioUrl);
        hideSuggestPop(); currentDoubtSpans=[]; transcriptModal.classList.add('hidden'); transcriptEdit.blur();
      }
      transcriptEdit.focus();
      const range = document.createRange(); range.selectNodeContents(transcriptEdit); range.collapse(false);
      const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
    });
  }

  let lastAudioBlob = null;

  async function processAudio(audioBlob, durationMs) {
    const startTime = Date.now();
    phase.reset();
    function setStatusLabel(label) {
      if (status) status.textContent = label;
    }

    setStatusLabel('Listening to your audio');
    const formData = new FormData();
    formData.append('audio', audioBlob, 'recording.webm');
    lastAudioBlob = audioBlob;

    try {
      const response = await fetch('/api/process-audio', { method: 'POST', body: formData });
      const data = await response.json();
      if (data.error) { if (status) status.textContent = data.error; return; }
      if (!data.transcription) { if (status) status.textContent = 'No transcription. Try again.'; return; }

      setStatusLabel('Review your transcript');
      const finalText = await askTranscription(data.transcription, data.uncertainWords, audioBlob);
      if (finalText === null) { if (status) status.textContent = 'Message discarded'; return; }

      const topic = getCurrentTopic();
      if (!topic) { if (status) status.textContent = 'No debate topic. Generate a new one.'; return; }

      addMessage('user', finalText);
      fluencyHistory.push({ role: 'user', content: finalText });
      setStatusLabel('Thinking...');
      try {
        resetAudioPlayback();
        currentChatAbort = new AbortController();
        const res = await fetch('/api/fluency-submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ topic, text: finalText, durationMs, history: fluencyHistory.slice(0, -1), startTime }),
          signal: currentChatAbort.signal,
        });
        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          if (status) status.textContent = errData.error || `Error ${res.status}`;
          return;
        }
        if (!res.body) {
          const errData = await res.json().catch(() => ({}));
          if (errData.error) { if (status) status.textContent = errData.error; return; }
        }
        // Handle NDJSON stream (debateId + chunks + audio)
        const msgEl = addMessage('assistant', '', true);
        const reader = res.body.getReader();
        const decoder = new TextDecoder();
        let buffer = '';
        let fullResponse = '';
        let debateIdFromStream = null;
        while (true) {
          const { done, value } = await reader.read();
          if (done) break;
          buffer += decoder.decode(value, { stream: true });
          const lines = buffer.split('\n');
          buffer = lines.pop() ?? '';
          for (const line of lines) {
            if (!line.trim()) continue;
            try {
              const parsed = JSON.parse(line);
              if (parsed.debateId) {
                debateIdFromStream = parsed.debateId;
                window.dispatchEvent(new CustomEvent('fluency-submitted', { detail: { debateId: parsed.debateId } }));
                const curEl = document.getElementById('fluency-current-debate');
                if (curEl) curEl.dataset.debateId = String(parsed.debateId);
              } else if (parsed.error) {
                if (status) status.textContent = parsed.error;
              } else if (parsed.chunk) {
                fullResponse += parsed.chunk;
                const p = msgEl.querySelector('p');
                if (p) p.textContent = fullResponse;
              } else if (parsed.audio) {
                playPcmChunk(parsed.audio);
              }
            } catch {}
          }
        }
        currentChatAbort = null;
        if (fullResponse) {
          fluencyHistory.push({ role: 'assistant', content: fullResponse });
          phase.start();
          // Also dispatch debateId if not yet
          if (debateIdFromStream) {
            window.dispatchEvent(new CustomEvent('fluency-submitted', { detail: { debateId: debateIdFromStream } }));
          }
        } else if (debateIdFromStream) {
          phase.start();
        }
      } catch (e) {
        if (e && (e as any).name === 'AbortError') { if (status && !isRecording) status.textContent = 'Click to start recording'; }
        else { console.error('Fluency submit error:', e); if (status) status.textContent = 'Error sending speech.'; }
      }
    } catch (error) {
      console.error('Error processing audio:', error);
      if (status) status.textContent = 'Error processing audio. Try again.';
    }
  }

  recordBtn?.addEventListener('click', () => {
    if (isRecording) stopRecording();
    else startRecording();
  });
  pauseBtn?.addEventListener('click', () => {
    if (!isRecording) return;
    if (isPaused) resumeRecording();
    else pauseRecording();
  });
  cancelBtn?.addEventListener('click', cancelRecording);
</script>


