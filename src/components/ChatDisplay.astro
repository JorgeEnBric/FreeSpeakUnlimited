---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div id={id} class="chat-display">
  <div class="message assistant">
    <div class="avatar">AI</div>
    <div class="content">
      <p>Hello! I'm your English conversation partner. Click the microphone button and start speaking. I'll respond to help you practice!</p>
    </div>
  </div>
</div>

