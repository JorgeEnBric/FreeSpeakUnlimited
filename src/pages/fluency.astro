---
import Layout from '../layouts/Layout.astro';
import ChatDisplay from '../components/ChatDisplay.astro';
import FluencyRecorder from '../components/FluencyRecorder.astro';
import PomodoroExpressionsPanel from '../components/PomodoroExpressionsPanel.astro';
---

<Layout title="Fluency Practice">
  <main class="app">
    <header class="header">
      <div class="header-main">
        <h2>Fluency Practice</h2>
        <p class="subtitle">Just turn on your microphone and speak openly</p>
      </div>
      <nav class="nav-links nav-toggle">
        <a href="/" class="nav-link">Chat mode</a>
        <a href="/fluency" class="nav-link active">Debate mode</a>
        <a href="/dice" class="nav-link">Dice mode</a>
      </nav>
    </header>

    <div class="main-content">
      <div class="chat-area">
        <section class="topic-card" id="topic-card">
          <div class="topic-header">
            <div class="topic-heading">
              <span class="topic-eyebrow">Topic</span>
              <h3>Free debate</h3>
            </div>
            <button id="new-topic-btn" class="topic-btn">New debate</button>
          </div>
          <p id="fluency-topic-text" class="topic-text">Press "New debate" to start aleatory debates</p>
          <div id="fluency-current-debate" data-debate-id="" style="display:none"></div>
        </section>

        <section class="chat-container">
          <ChatDisplay id="fluency-chat" />
        </section>

        <section class="controls">
          <FluencyRecorder />
        </section>
      </div>

      <aside class="trace-panel">
        <div class="panel-header">
          <h3>Automatic corrections</h3>
          <span id="corr-count" class="panel-badge">0</span>
        </div>
        <span class="trace-hint">Corrections from the current conversation</span>
        <button id="clear-fluency" class="clear-btn">Clean debate</button>
        <div id="fluency-trace-results" class="trace-results">
          <p class="trace-empty">Speak to get automatic corrections</p>
        </div>
      </aside>

      <PomodoroExpressionsPanel />
    </div>
  </main>

  <div id="warmup-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-spinner"></div>
      <p>Sending conversation and corrections system prompt to cache...</p>
    </div>
  </div>

  <div id="ctx-menu" class="ctx-menu" style="display:none">
    <button id="ctx-add-expression" class="ctx-item">Save to New Expressions</button>
    <button id="ctx-translate" class="ctx-item">Translate to Spanish</button>
  </div>

  <div id="translation-popup" class="translation-popup" style="display:none">
    <button id="translation-close" class="translation-close" title="Close">×</button>
    <div class="translation-label">Translation</div>
    <div id="translation-content" class="translation-content"></div>
  </div>
</Layout>

<script>
  // Warmup
  (async () => {
    try { await fetch('/api/warmup', { method: 'POST' }); } finally {
      const modal = document.getElementById('warmup-modal');
      if (modal) modal.classList.add('hidden');
    }
  })();

  // Debate topic handling
  const topicTextEl = document.getElementById('fluency-topic-text');
  const newTopicBtn = document.getElementById('new-topic-btn');
  const currentDebateEl = document.getElementById('fluency-current-debate');

  async function loadNewTopic() {
    if (!topicTextEl || !newTopicBtn) return;
    window.dispatchEvent(new CustomEvent('fluency-topic-reset'));
    newTopicBtn.disabled = true;
    newTopicBtn.textContent = 'Generating...';
    topicTextEl.textContent = 'Generating topic...';
    try {
      const res = await fetch('/api/fluency-topic', { method: 'POST' });
      const data = await res.json();
      if (data.topic) {
        topicTextEl.textContent = data.topic;
        window.dispatchEvent(new CustomEvent('fluency-topic-ready'));
        // Limpiar chat por completo
        const chat = document.getElementById('fluency-chat');
        if (chat) chat.innerHTML = '';
        // Notificar a FluencyRecorder para limpiar historial
        window.dispatchEvent(new CustomEvent('fluency-new-topic'));
        // Reset trace for new debate (topic no persiste, solo memoria)
        const results = document.getElementById('fluency-trace-results');
        if (results) results.innerHTML = '<p class="trace-empty">Speak to get automatic corrections</p>';
        updateCorrCount(0);
        lastDebateCorrectionId = 0;
        isFirstDebateLoad = true;
        if (currentDebateEl) currentDebateEl.dataset.debateId = '';
        currentDebateId = null;
      } else {
        topicTextEl.textContent = 'Could not generate topic. Try again.';
      }
    } catch (e) {
      topicTextEl.textContent = 'Error generating topic.';
    }
    newTopicBtn.disabled = false;
    newTopicBtn.textContent = 'New debate';
  }

  newTopicBtn?.addEventListener('click', loadNewTopic);

  // Fluency corrections polling - solo debate actual
  let fluencyPollingId: ReturnType<typeof setInterval> | null = null;
  let lastDebateCorrectionId = 0;
  let isFirstDebateLoad = true;
  let currentDebateId: number | null = null;

  // Listen for fluency submission to set current debateId
  window.addEventListener('fluency-submitted', (event: any) => {
    const debateId = event.detail?.debateId;
    if (debateId) {
      currentDebateId = debateId;
      if (currentDebateEl) currentDebateEl.dataset.debateId = String(debateId);
      lastDebateCorrectionId = 0;
      isFirstDebateLoad = true;
      const results = document.getElementById('fluency-trace-results');
      if (results) results.innerHTML = '<p class="trace-loading">Analyzing your speech...</p>';
    }
  });

  function updateFluencyStatus(msg: string) {
    const results = document.getElementById('fluency-trace-results');
    if (!results) return;
    let statusEl = results.querySelector('.trace-status') as HTMLElement | null;
    if (!statusEl) {
      statusEl = document.createElement('p');
      statusEl.className = 'trace-status trace-loading';
    }
    statusEl.textContent = msg;
    if (results.firstChild !== statusEl) results.prepend(statusEl);
  }

  function removeFluencyStatus() {
    const results = document.getElementById('fluency-trace-results');
    if (!results) return;
    const statusEl = results.querySelector('.trace-status');
    if (statusEl) statusEl.remove();
  }

  function updateCorrCount(n: number) {
    const badge = document.getElementById('corr-count');
    if (badge) badge.textContent = String(n);
  }

  function renderFluencyCard(corr: any): string {
    const hasTime = corr.processing_ms != null;
    const timeLabel = hasTime ? Math.round(corr.processing_ms / 1000) + 's' : '-';
    return `
        <div class="corr-card" data-id="${corr.id}">
          <div class="corr-header"><span class="corr-tag">${corr.label || corr.code}</span><span class="corr-time">${timeLabel}</span></div>
          <div class="corr-row bad"><span class="corr-bad">${corr.original}</span></div>
          <div class="corr-row good"><span class="corr-arrow">→</span><span class="corr-good">${corr.corrected}</span></div>
        </div>`;
  }

  function renderAllFluencyCorrections(corrections: any[]) {
    const results = document.getElementById('fluency-trace-results');
    if (!results) return;
    if (!corrections || corrections.length === 0) {
      results.innerHTML = '<p class="trace-empty">Speak to get automatic corrections</p>';
      updateCorrCount(0);
      return;
    }
    let html = '<div class="trace-cards">';
    for (const corr of corrections) html += renderFluencyCard(corr);
    html += '</div>';
    results.innerHTML = html;
    updateCorrCount(corrections.length);
    let maxId = 0;
    for (const corr of corrections) if (corr.id > maxId) maxId = corr.id;
    if (maxId > lastDebateCorrectionId) lastDebateCorrectionId = maxId;
  }

  function appendNewFluencyCorrections(corrections: any[]) {
    if (!corrections || corrections.length === 0) return;
    const results = document.getElementById('fluency-trace-results');
    if (!results) return;
    let container = results.querySelector('.trace-cards') as HTMLElement | null;
    if (!container) {
      const empty = results.querySelector('.trace-empty');
      if (empty) empty.remove();
      container = document.createElement('div');
      container.className = 'trace-cards';
      const statusEl = results.querySelector('.trace-status');
      if (statusEl) statusEl.after(container);
      else results.appendChild(container);
    }
    for (const corr of corrections) {
      const card = document.createElement('div');
      card.innerHTML = renderFluencyCard(corr).trim();
      const cardEl = card.firstElementChild as HTMLElement;
      if (cardEl && container) container.prepend(cardEl);
      if (corr.id > lastDebateCorrectionId) lastDebateCorrectionId = corr.id;
    }
    updateCorrCount(container.querySelectorAll('.corr-card').length);
  }

  function renderFluencyPanel(data: any) {
    const results = document.getElementById('fluency-trace-results');
    if (!results) return;
    // Si no hay debate actual, no mostrar previas (solo debate actual)
    if (!currentDebateId) {
      if (isFirstDebateLoad) {
        renderAllFluencyCorrections([]);
        isFirstDebateLoad = false;
        removeFluencyStatus();
      }
      return;
    }
    if (isFirstDebateLoad) {
      const initial = (data.corrections ?? data.newCorrections ?? []) as any[];
      // API ya filtra por debateId, pero filtrar de nuevo por seguridad
      const filtered = initial.filter((c: any) => c.debate_id === currentDebateId);
      renderAllFluencyCorrections(filtered);
      isFirstDebateLoad = false;
      if (data.analyzing && data.queueLength > 0) updateFluencyStatus(`Analizando... (${data.queueLength} en cola)`);
      else if (data.analyzing) updateFluencyStatus('Analyzing your speech');
      else removeFluencyStatus();
      return;
    }
    if (data.newCorrections?.length) {
      const nuevos = (data.newCorrections as any[]).filter((c: any) => c.debate_id === currentDebateId);
      if (nuevos.length) appendNewFluencyCorrections(nuevos);
    } else if (data.corrections?.length) {
      const nuevos = (data.corrections as any[]).filter((c: any) => c.debate_id === currentDebateId).filter((c: any) => c.id > lastDebateCorrectionId).sort((a: any, b: any) => a.id - b.id);
      if (nuevos.length) appendNewFluencyCorrections(nuevos);
    }
    if (data.analyzing && data.queueLength > 0) updateFluencyStatus(`Analizando... (${data.queueLength} en cola)`);
    else if (data.analyzing) updateFluencyStatus('Analyzing your speech');
    else removeFluencyStatus();
  }

  async function pollFluencyCorrections() {
    try {
      if (!currentDebateId) {
        if (isFirstDebateLoad) {
          renderAllFluencyCorrections([]);
          isFirstDebateLoad = false;
          removeFluencyStatus();
        }
        return;
      }
      const res = await fetch(`/api/fluency-corrections-status?since=${lastDebateCorrectionId}&debateId=${currentDebateId}`);
      const data = await res.json();
      renderFluencyPanel(data);
      window.dispatchEvent(new CustomEvent('analysis-phase', {
        detail: { analyzing: !!data.analyzing, queueLength: data.queueLength ?? 0 },
      }));
    } catch (e) { console.error('[pollFluency]', e); }
  }

  function startFluencyPolling() {
    if (fluencyPollingId) return;
    pollFluencyCorrections();
    fluencyPollingId = setInterval(pollFluencyCorrections, 3000);
  }

  startFluencyPolling();

  document.getElementById('clear-fluency')?.addEventListener('click', async () => {
    const btn = document.getElementById('clear-fluency') as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Clearing...';
    try {
      // Solo limpia UI, no borra DB histórico (topic no persiste)
      const results = document.getElementById('fluency-trace-results');
      if (results) results.innerHTML = '<p class="trace-empty">Debate cleared.</p>';
      updateCorrCount(0);
      lastDebateCorrectionId = 0;
      isFirstDebateLoad = true;
      currentDebateId = null;
      if (currentDebateEl) currentDebateEl.dataset.debateId = '';
    } finally {
      btn.disabled = false;
      btn.textContent = 'Clean debate';
    }
  });

  // Context menu global (copiado de index)
  const contextMenu = document.getElementById('ctx-menu');
  const translationPopup = document.getElementById('translation-popup');
  const translationContent = document.getElementById('translation-content');
  let contextMenuItem: any = null;

  function positionPopup(element: HTMLElement, clientX: number, clientY: number) {
    const rect = element.getBoundingClientRect();
    const margin = 8;
    let left = clientX;
    let top = clientY + margin;
    if (left + rect.width > window.innerWidth - margin) left = Math.max(margin, window.innerWidth - rect.width - margin);
    if (top + rect.height > window.innerHeight - margin) top = Math.max(margin, clientY - rect.height - margin);
    element.style.left = `${left}px`;
    element.style.top = `${top}px`;
  }

  document.addEventListener('contextmenu', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('#ctx-menu, #translation-popup, #warmup-modal')) return;
    if (target.closest('#fluency-transcript-modal')) return;
    const selection = window.getSelection()?.toString().trim() ?? '';
    if (!selection) return;
    event.preventDefault();
    contextMenuItem = { expression: selection, text: selection, x: event.clientX, y: event.clientY };
    if (contextMenu) {
      contextMenu.style.display = 'block';
      positionPopup(contextMenu, event.clientX, event.clientY);
    }
    if (translationPopup) { translationPopup.style.display = 'none'; if (translationContent) translationContent.textContent = ''; }
  });

  function hideContextMenu() { if (contextMenu) contextMenu.style.display = 'none'; }
  function hideTranslationPopup() { if (translationPopup) { translationPopup.style.display = 'none'; if (translationContent) translationContent.textContent = ''; } }
  document.addEventListener('click', (event) => {
    hideContextMenu();
    if (translationPopup && !translationPopup.contains(event.target as Node) && !(event.target as HTMLElement).closest('#ctx-translate')) hideTranslationPopup();
  });
  document.addEventListener('keydown', (event) => { if (event.key !== 'Escape') return; hideContextMenu(); hideTranslationPopup(); });
  document.getElementById('ctx-add-expression')?.addEventListener('click', async () => {
    if (contextMenu) contextMenu.style.display = 'none';
    if (!contextMenuItem) return;
    try {
      const res = await fetch('/api/expressions/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(contextMenuItem) });
      const data = await res.json();
      if (data.error) alert(`Error: ${data.error}`);
      else window.dispatchEvent(new CustomEvent('expressions-updated'));
    } catch (e) { console.error(e); }
  });
  document.getElementById('ctx-translate')?.addEventListener('click', async () => {
    hideContextMenu();
    if (!contextMenuItem || !translationPopup || !translationContent) return;
    const { text, x, y } = contextMenuItem;
    if (!text) return;
    positionPopup(translationPopup, x, y);
    translationPopup.style.display = 'block';
    translationContent.textContent = 'Traduciendo…';
    try {
      const res = await fetch('/api/translate', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ text }) });
      const data = await res.json();
      if (data.error) translationContent.textContent = `Error: ${data.error}`;
      else if (data.translated) translationContent.textContent = data.translated;
      else translationContent.textContent = 'No se pudo traducir.';
    } catch (e) { console.error(e); translationContent.textContent = 'Error de conexión.'; }
  });
  document.getElementById('translation-close')?.addEventListener('click', hideTranslationPopup);
</script>


<style is:global>
  .topic-card { background: var(--surface-2); border: 1px solid var(--border-subtle); border-left: 3px solid var(--accent); border-radius: var(--radius-md); padding: 1rem 1.25rem; margin-bottom: 1rem; }
  .topic-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 0.6rem; }
  .topic-heading { text-align: left; min-width: 0; }
  .topic-eyebrow { display: block; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.2rem; }
  .topic-header h3 { margin: 0; font-size: 1.05rem; font-weight: 600; color: var(--text); }
  .topic-btn { padding: 0.45rem 0.9rem; border: none; border-radius: var(--radius-sm); background: var(--accent); color: var(--on-accent); font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: background 0.15s, transform 0.15s; white-space: nowrap; flex-shrink: 0; }
  .topic-btn:hover:not(:disabled) { background: var(--accent-hover); }
  .topic-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .topic-text { font-size: 0.98rem; color: var(--text-secondary); line-height: 1.55; min-height: 1.5rem; }
</style>