---
export const prerender = false;
export const getStaticProps = async () => {
  return {};
};
---
<pre id="logOutput" style="font-family: monospace; white-space: pre-wrap; background: #f8f8f8; padding: 1rem; height: 90vh; overflow: auto;"></pre>

<script is:inline>
  const POLL_MS = 15000;
  const CLEAR_MS = 15 * 60_000;
  let lastClear = Date.now();

  async function loadLogs() {
    const res = await fetch('/api/logs');
    if (!res.ok) {
      document.getElementById('logOutput').textContent = 'Error loading logs';
      return;
    }
    const { logs } = await res.json();
    const now = Date.now();
    // filtro: solo mostrar mensajes desde el ultimo clear (cada 15 min)
    const cutoff = now - CLEAR_MS;
    const recientes = logs.filter(([ts]) => ts >= cutoff);
    const lines = recientes.map(([ts, msg]) => `${new Date(ts).toLocaleTimeString()} • ${msg}`).join('\n');
    const output = document.getElementById('logOutput');
    output.textContent = lines || 'No hay logs';
    // auto-scroll al final
    output.scrollTop = output.scrollHeight;

    // reset del marcador cada 15 min
    if (now - lastClear >= CLEAR_MS) {
      lastClear = now;
    }
  }

  loadLogs();
  setInterval(loadLogs, POLL_MS);
</script>