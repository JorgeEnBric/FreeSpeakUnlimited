---
import Layout from '../layouts/Layout.astro';
import ChatDisplay from '../components/ChatDisplay.astro';
import AudioRecorder from '../components/AudioRecorder.astro';
---

<Layout title="FreeSpeak Unlimited">
  <main class="app">
    <header class="header">
      <h1>FreeSpeak Unlimited</h1>
      <p class="subtitle">Practice speaking English without limits</p>
    </header>

    <div class="main-content">
      <div class="chat-area">
        <section class="chat-container">
          <ChatDisplay id="chat" />
        </section>

        <section class="controls">
          <AudioRecorder />
        </section>
      </div>

      <aside class="trace-panel">
        <h3>Trace de Correcciones</h3>
        <button id="clear-record" class="clear-btn">Limpiar registro</button>
        <div id="trace-results" class="trace-results">
          <p class="trace-empty">Habla para recibir correcciones automáticas</p>
        </div>
      </aside>

      <aside class="pomodoro-panel">
        <h3>Pomodoro</h3>
        <div class="pomodoro-time" id="pomodoro-time">25:00</div>
        <div class="pomodoro-controls">
          <button id="pomodoro-toggle" class="pomodoro-btn">Iniciar</button>
          <button id="pomodoro-reset" class="pomodoro-btn ghost">Reiniciar</button>
        </div>

        <div class="panel-divider"></div>

        <h3 class="expressions-title">Nuevas Expresiones</h3>
        <p class="expressions-hint">Selecciona una frase en el chat y haz clic derecho para guardarla aquí</p>
        <div id="expressions-list" class="expressions-list">
          <p class="expressions-empty">Aún no hay expresiones guardadas</p>
        </div>
      </aside>
    </div>
  </main>

  <div id="warmup-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-spinner"></div>
      <p>Enviando el system prompt de conversación y de correcciones al cache...</p>
    </div>
  </div>

  <div id="ctx-menu" class="ctx-menu" style="display:none">
    <button id="ctx-add-expression" class="ctx-item">Guardar en Nuevas Expresiones</button>
    <button id="ctx-translate" class="ctx-item">Traducir al español</button>
  </div>

  <div id="translation-popup" class="translation-popup" style="display:none">
    <button id="translation-close" class="translation-close" title="Cerrar">×</button>
    <div class="translation-label">Traducción</div>
    <div id="translation-content" class="translation-content"></div>
  </div>

<script>
  // Warm up the system prompt cache on page load
  (async () => {
    try {
      await fetch('/api/warmup', { method: 'POST' });
    } finally {
      const modal = document.getElementById('warmup-modal');
      if (modal) modal.classList.add('hidden');
    }
  })();

  // Polling for automatic corrections with incremental updates
  let corrPollingId: ReturnType<typeof setInterval> | null = null;
  let lastCorrectionId = 0;
  let isFirstLoad = true;

  function updateStatusMessage(msg: string) {
    const results = document.getElementById('trace-results');
    if (!results) return;
    let statusEl = results.querySelector('.trace-status');
    if (!statusEl) {
      statusEl = document.createElement('p');
      statusEl.className = 'trace-status trace-loading';
      results.appendChild(statusEl);
    }
    statusEl.textContent = msg;
  }

  function removeStatusMessage() {
    const results = document.getElementById('trace-results');
    if (!results) return;
    const statusEl = results.querySelector('.trace-status');
    if (statusEl) statusEl.remove();
  }

  function renderCard(corr: any): string {
    return `
        <div class="corr-card" data-id="${corr.id}">
          <span class="corr-tag">${corr.label || corr.code}</span>
          <div class="corr-row"><span class="corr-bad">${corr.original}</span></div>
          <div class="corr-row"><span class="corr-arrow">→</span><span class="corr-good">${corr.corrected || corr.tip}</span></div>
        </div>`;
  }

  function renderAllCorrections(corrections: any[]) {
    const results = document.getElementById('trace-results');
    if (!results) return;

    if (!corrections || corrections.length === 0) {
      results.innerHTML = '<p class="trace-empty">Habla para recibir correcciones automáticas</p>';
      return;
    }

    let html = '<div class="trace-cards">';
    for (const corr of corrections) {
      html += renderCard(corr);
    }
    html += '</div>';
    results.innerHTML = html;

    // Set lastCorrectionId from loaded data
    let maxId = 0;
    for (const corr of corrections) {
      if (corr.id > maxId) maxId = corr.id;
    }
    if (maxId > lastCorrectionId) lastCorrectionId = maxId;
  }

  function appendNewCorrections(corrections: any[]) {
    if (!corrections || corrections.length === 0) return;

    const results = document.getElementById('trace-results');
    if (!results) return;

    // If empty, create the container
    let container = results.querySelector('.trace-cards');
    if (!container) {
      results.innerHTML = '<div class="trace-cards"></div>';
      container = results.querySelector('.trace-cards');
    }

    // Corrections arrive oldest-first; prepending each leaves the newest on top
    for (const corr of corrections) {
      const card = document.createElement('div');
      card.innerHTML = renderCard(corr).trim();
      const cardEl = card.firstElementChild as HTMLElement;
      if (cardEl && container) container.prepend(cardEl);
      if (corr.id > lastCorrectionId) lastCorrectionId = corr.id;
    }

    removeStatusMessage();
  }

  function renderCorrectionsPanel(data: any) {
    const results = document.getElementById('trace-results');
    if (!results) return;

    // Initial load: render all corrections
    if (isFirstLoad && data.corrections) {
      renderAllCorrections(data.corrections);
      isFirstLoad = false;

      // Show analyzing status after initial load
      if (data.analyzing && data.queueLength > 0) {
        updateStatusMessage(`Analizando... (${data.queueLength} en cola)`);
      } else if (data.analyzing) {
        updateStatusMessage('Analizando tu frase');
      }
      return;
    }

    // Incremental update: append new corrections
    if (data.newCorrections && data.newCorrections.length > 0) {
      appendNewCorrections(data.newCorrections);
    }

    // Update status messages
    if (data.analyzing && data.queueLength > 0) {
      updateStatusMessage(`Analizando... (${data.queueLength} en cola)`);
    } else if (data.analyzing) {
      updateStatusMessage('Analizando tu frase');
    } else {
      removeStatusMessage();
    }
  }

  async function pollCorrections() {
    try {
      const res = await fetch(`/api/corrections-status?since=${lastCorrectionId}`);
      const data = await res.json();
      renderCorrectionsPanel(data);
    } catch (e) {
      // silently ignore polling errors
    }
  }

  function startCorrectionsPolling() {
    if (corrPollingId) return;
    pollCorrections();
    corrPollingId = setInterval(pollCorrections, 3000);
  }

  startCorrectionsPolling();

  document.getElementById('clear-record')?.addEventListener('click', async () => {
    const btn = document.getElementById('clear-record');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Limpiando...';
    try {
      const res = await fetch('/api/clear-all', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const data = await res.json();
      if (data.error) {
        alert(`Error: ${data.error}`);
      } else {
        const results = document.getElementById('trace-results');
        if (results) results.innerHTML = '<p class="trace-empty">Correcciones limpiadas.</p>';
        lastCorrectionId = 0;
        isFirstLoad = true;
      }
    } catch (e) {
      alert('Error al limpiar el registro.');
    }
    btn.disabled = false;
    btn.textContent = 'Limpiar registro';
  });

  // Pomodoro timer: 25 min work / 5 min break, with pause/resume
  (() => {
    const WORK_MIN = 25;
    const BREAK_MIN = 5;
    const timeEl = document.getElementById('pomodoro-time');
    const toggleBtn = document.getElementById('pomodoro-toggle');
    const resetBtn = document.getElementById('pomodoro-reset');
    if (!timeEl || !toggleBtn || !resetBtn) return;

    let mode = 'work';
    let remaining = WORK_MIN * 60;
    let running = false;
    let intervalId = null;
    let endTime = 0;
    let ringCtx = null;

    function ensureRingCtx() {
      if (!ringCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        ringCtx = new Ctx();
      }
      if (ringCtx.state === 'suspended') ringCtx.resume();
      return ringCtx;
    }

    function playRing() {
      try {
        if (!ringCtx) return;
        const ctx = ringCtx;
        const now = ctx.currentTime;
        const notes = [880, 880, 880, 660];
        const step = 0.3;
        const dur = 0.22;
        notes.forEach((freq, i) => {
          const start = now + i * step;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'square';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.exponentialRampToValueAtTime(0.25, start + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(start);
          osc.stop(start + dur + 0.05);
        });
      } catch (e) {
        console.error('Ring sound error:', e);
      }
    }

    function fmt(totalSeconds) {
      const s = Math.max(0, Math.ceil(totalSeconds));
      return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    }

    function render() {
      timeEl.textContent = fmt(remaining);
      toggleBtn.textContent = running ? 'Pausar' : 'Iniciar';
      toggleBtn.classList.toggle('hidden', remaining === 0);
      resetBtn.textContent = (mode === 'work' && remaining === WORK_MIN * 60 && !running) ? 'Reiniciar' : 'Reiniciar';
    }

    function tick() {
      remaining = Math.max(0, (endTime - Date.now()) / 1000);
      if (remaining <= 0) {
        clearInterval(intervalId);
        running = false;
        switchMode();
      }
      render();
    }

    function switchMode() {
      playRing();
      mode = mode === 'work' ? 'break' : 'work';
      remaining = (mode === 'work' ? WORK_MIN : BREAK_MIN) * 60;
      if (toggleBtn) toggleBtn.textContent = 'Iniciar';
      startTimer();
    }

    function startTimer() {
      if (remaining <= 0) return;
      running = true;
      endTime = Date.now() + remaining * 1000;
      clearInterval(intervalId);
      intervalId = setInterval(tick, 200);
      render();
    }

    function pauseTimer() {
      running = false;
      clearInterval(intervalId);
      intervalId = null;
      render();
    }

    function resetTimer() {
      running = false;
      clearInterval(intervalId);
      intervalId = null;
      mode = 'work';
      remaining = WORK_MIN * 60;
      render();
    }

    toggleBtn.addEventListener('click', () => {
      ensureRingCtx();
      if (running) pauseTimer();
      else startTimer();
    });

    resetBtn.addEventListener('click', resetTimer);

    render();
  })();

  // New Expressions panel: load saved expressions as mini cards
  const expressionsList = document.getElementById('expressions-list');
  async function loadExpressions() {
    if (!expressionsList) return;
    try {
      const res = await fetch('/api/expressions');
      const data = await res.json();
      if (data.expressions) {
        if (data.expressions.length === 0) {
          expressionsList.innerHTML = '<p class="expressions-empty">Aún no hay expresiones guardadas</p>';
        } else {
          expressionsList.innerHTML = data.expressions
            .map((e) => `
              <div class="miniTarjeta">
                <span class="miniTarjeta-text">${e.expression}</span>
                <button class="miniTarjeta-check" data-id="${e.id}" title="Marcar como aprendida">✔</button>
              </div>`)
            .join('');
        }
      }
    } catch (error) {
      console.error('Error loading expressions:', error);
    }
  }
  loadExpressions();

  // Delete expression on check click
  expressionsList?.addEventListener('click', async (event) => {
    const btn = (event.target as HTMLElement).closest('.miniTarjeta-check');
    if (!btn) return;
    const id = (btn as HTMLElement).dataset.id;
    if (!id) return;
    try {
      await fetch(`/api/expressions/${id}`, { method: 'DELETE' });
      await loadExpressions();
    } catch (error) {
      console.error('Error deleting expression:', error);
    }
  });

  // Custom context menu on chat messages: add selected text to NewExpressions or translate it
  const chatDisplay = document.getElementById('chat');
  const contextMenu = document.getElementById('ctx-menu');
  const translationPopup = document.getElementById('translation-popup');
  const translationContent = document.getElementById('translation-content');
  let contextMenuItem = null;

  function positionPopup(element: HTMLElement, clientX: number, clientY: number) {
    const rect = element.getBoundingClientRect();
    const margin = 8;
    let left = clientX;
    let top = clientY + margin;

    if (left + rect.width > window.innerWidth - margin) {
      left = Math.max(margin, window.innerWidth - rect.width - margin);
    }
    if (top + rect.height > window.innerHeight - margin) {
      top = Math.max(margin, clientY - rect.height - margin);
    }
    element.style.left = `${left}px`;
    element.style.top = `${top}px`;
  }

  chatDisplay?.addEventListener('contextmenu', (event) => {
    const selection = window.getSelection()?.toString().trim();
    if (!selection) return;

    event.preventDefault();
    contextMenuItem = { expression: selection, text: selection, x: event.clientX, y: event.clientY };

    if (contextMenu) {
      contextMenu.style.left = `${event.clientX}px`;
      contextMenu.style.top = `${event.clientY}px`;
      contextMenu.style.display = 'block';
    }
  });

  function hideContextMenu() {
    if (contextMenu) contextMenu.style.display = 'none';
  }

  function hideTranslationPopup() {
    if (translationPopup) {
      translationPopup.style.display = 'none';
      if (translationContent) translationContent.textContent = '';
    }
  }

  document.addEventListener('click', (event) => {
    hideContextMenu();
    if (
      translationPopup &&
      !translationPopup.contains(event.target as Node) &&
      !(event.target as HTMLElement).closest('#ctx-translate')
    ) {
      hideTranslationPopup();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    hideContextMenu();
    hideTranslationPopup();
  });

  document.getElementById('ctx-add-expression')?.addEventListener('click', async () => {
    if (contextMenu) contextMenu.style.display = 'none';
    if (!contextMenuItem) return;

    try {
      const res = await fetch('/api/expressions/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(contextMenuItem),
      });
      const data = await res.json();
      if (data.error) {
        alert(`Error: ${data.error}`);
      } else {
        await loadExpressions();
      }
    } catch (error) {
      console.error('Error saving expression:', error);
    }
  });

  // Translate selected text to Spanish and show a small cloud popup
  document.getElementById('ctx-translate')?.addEventListener('click', async () => {
    hideContextMenu();
    if (!contextMenuItem || !translationPopup || !translationContent) return;

    const { text, x, y } = contextMenuItem;
    if (!text) return;

    positionPopup(translationPopup, x, y);

    translationPopup.style.display = 'block';
    translationContent.textContent = 'Traduciendo…';

    try {
      const res = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      const data = await res.json();
      if (data.error) {
        translationContent.textContent = `Error: ${data.error}`;
      } else if (data.translated) {
        translationContent.textContent = data.translated;
      } else {
        translationContent.textContent = 'No se pudo traducir el texto.';
      }
    } catch (error) {
      console.error('Error translating text:', error);
      translationContent.textContent = 'Error de conexión al traducir.';
    }
  });

  document.getElementById('translation-close')?.addEventListener('click', hideTranslationPopup);
</script>
</Layout>

<style is:global>
  .timer {
    font-variant-numeric: tabular-nums;
    background: rgba(0,0,0,0.08);
    padding: 1px 6px;
    border-radius: 4px;
    margin-right: 6px;
    font-size: 0.85em;
    font-family: monospace;
  }
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0,0,0,0.55);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal-overlay.hidden {
    display: none;
  }
  .modal-box {
    background: #fff;
    border-radius: 12px;
    padding: 28px 36px;
    max-width: 420px;
    text-align: center;
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
    color: #333;
    font-size: 0.95rem;
  }
  .modal-spinner {
    width: 36px;
    height: 36px;
    margin: 0 auto 16px;
    border: 4px solid rgba(0,0,0,0.12);
    border-top-color: #6b46c1;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .app {
    display: flex;
    flex-direction: column;
    height: 100vh;
    max-width: 1420px;
    margin: 0 auto;
    padding: 1rem;
  }

  .header {
    text-align: center;
    padding: 0.5rem 0;
  }

  .header h1 {
    font-size: 2rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--primary), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
  }

  .main-content {
    display: flex;
    flex: 1;
    gap: 1rem;
    min-height: 0;
  }

  .chat-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chat-container {
    flex: 1;
    overflow-y: auto;
    background: var(--surface);
    border-radius: var(--border-radius);
    padding: 1rem;
    margin-bottom: 1rem;
  }

  .controls {
    display: flex;
    justify-content: center;
    padding: 0.5rem 0;
  }

  .trace-panel {
    width: 340px;
    flex-shrink: 0;
    background: var(--surface);
    border-radius: var(--border-radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border-left: 1px solid rgba(255,255,255,0.06);
  }

  .trace-panel h3 {
    font-size: 1rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .trace-panel h3::before {
    content: '📝';
    font-size: 1.1rem;
  }

  .clear-btn {
    padding: 0.6rem 1rem;
    border: 1px solid var(--recording, #dc2626);
    border-radius: 8px;
    background: transparent;
    color: var(--recording, #dc2626);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .clear-btn:hover:not(:disabled) {
    background: rgba(220, 38, 38, 0.1);
  }

  .clear-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .trace-results {
    flex: 1;
    overflow-y: auto;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .trace-empty, .trace-loading, .trace-error {
    color: var(--text-muted);
    text-align: center;
    padding: 1.5rem 0;
    font-size: 0.85rem;
  }

  .trace-cards {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .corr-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .corr-group-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.2rem;
  }

  .corr-group-code {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--primary);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .corr-tag {
    align-self: flex-start;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--primary);
    background: rgba(59, 130, 246, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
  }

  .corr-group-label {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .corr-card {
    background: #0f172a;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .corr-row {
    display: flex;
    align-items: flex-start;
    gap: 0.35rem;
    padding: 0.25rem 0.4rem;
    border-radius: 5px;
  }

  .corr-row:first-of-type {
    background: rgba(248, 113, 113, 0.08);
    border-left: 3px solid #f87171;
  }

  .corr-row:last-of-type {
    background: rgba(74, 222, 128, 0.08);
    border-left: 3px solid #4ade80;
  }

  .corr-bad {
    color: #fca5a5;
    font-size: 0.8rem;
    text-decoration: line-through;
    text-decoration-color: #f87171;
    line-height: 1.4;
  }

  .corr-arrow {
    color: var(--text-muted);
    font-size: 0.8rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .corr-good {
    color: #86efac;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .pomodoro-panel {
    width: 220px;
    flex-shrink: 0;
    background: var(--surface);
    border-radius: var(--border-radius);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    border-left: 1px solid rgba(255,255,255,0.06);
  }

  .pomodoro-panel h3 {
    font-size: 1rem;
    color: var(--text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .pomodoro-panel h3::before {
    content: '⏱️';
    font-size: 1.1rem;
  }

  .pomodoro-panel h3.expressions-title::before {
    content: '✨';
  }

  .pomodoro-time {
    font-size: 3rem;
    font-weight: 700;
    font-family: monospace;
    font-variant-numeric: tabular-nums;
    color: var(--text);
    line-height: 1;
  }

  .pomodoro-controls {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .pomodoro-btn {
    flex: 1;
    padding: 0.55rem 0.5rem;
    border: none;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--primary), #8b5cf6);
    color: white;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 2px 8px rgba(59, 130, 246, 0.3);
  }

  .pomodoro-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
  }

