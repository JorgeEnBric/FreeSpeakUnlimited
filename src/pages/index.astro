---
import Layout from '../layouts/Layout.astro';
import ChatDisplay from '../components/ChatDisplay.astro';
import AudioRecorder from '../components/AudioRecorder.astro';
---

<Layout title="FreeSpeak Unlimited">
  <main class="app">
    <header class="header">
      <button id="settings-btn" class="gear-btn" aria-label="Settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.09a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.72l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/></svg>
      </button>
      <div class="header-main">
        <h1>FreeSpeak Unlimited</h1>
        <p class="subtitle">Practice speaking English without limits</p>
      </div>
      <nav class="nav-links nav-toggle">
        <a href="/" class="nav-link active">Chat mode</a>
        <a href="/fluency" class="nav-link">Debate mode</a>
        <a href="/dice" class="nav-link">Dice mode</a>
      </nav>
    </header>

    <div class="main-content">
      <div class="chat-area">
        <section class="chat-container">
          <ChatDisplay id="chat" />
        </section>

        <section class="controls">
          <AudioRecorder />
        </section>
      </div>

      <aside class="trace-panel">
        <h3>Automatic corrections</h3>
        <button id="clear-record" class="clear-btn">Clean trace</button>
        <div id="trace-results" class="trace-results">
          <p class="trace-empty">No expressions to show yet </p>
        </div>
      </aside>

      <aside class="pomodoro-panel">
        <h3>Pomodoro</h3>
        <div class="pomodoro-time" id="pomodoro-time">25:00</div>
        <div class="pomodoro-controls">
          <button id="pomodoro-toggle" class="pomodoro-btn icon" aria-label="Start"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
          <button id="pomodoro-reset" class="pomodoro-btn icon ghost" aria-label="Reset"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg></button>
        </div>

        <div class="panel-divider"></div>

        <h3 class="expressions-title">New expressions</h3>
        <p class="expressions-hint">Select text anywhere and right-click to save it here</p>
        <div id="expressions-list" class="expressions-list">
          <p class="expressions-empty">No expressions saved yet</p>
        </div>
      </aside>
    </div>
  </main>

  <div id="warmup-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-spinner"></div>
      <p>Sending conversation and corrections system prompt to cache...</p>
    </div>
  </div>

  <div id="settings-modal" class="modal-overlay hidden">
    <div class="modal-box settings-box">
      <h3 class="settings-title">Settings</h3>
      <p class="settings-subtitle">Appearance</p>
      <div class="theme-toggle" role="group" aria-label="Theme">
        <button type="button" class="theme-option" data-theme-set="dark">Dark</button>
        <button type="button" class="theme-option" data-theme-set="light">Light</button>
      </div>
      <p class="settings-subtitle">Maintenance</p>
      <button id="clear-db-btn" class="clear-btn settings-action">Clear database</button>
      <p class="settings-hint">Deletes corrections, debates, messages, expressions and logs. Keeps patterns.</p>
      <button id="settings-close" class="btn-ghost settings-action">Close</button>
    </div>
  </div>

  <div id="ctx-menu" class="ctx-menu" style="display:none">
    <button id="ctx-add-expression" class="ctx-item">Save to New Expressions</button>
    <button id="ctx-translate" class="ctx-item">Translate to Spanish</button>
  </div>

  <div id="translation-popup" class="translation-popup" style="display:none">
    <button id="translation-close" class="translation-close" title="Close">Ã—</button>
    <div class="translation-label">Translation</div>
    <div id="translation-content" class="translation-content"></div>
  </div>

<script>
  // Warm up the system prompt cache on page load
  (async () => {
    try {
      await fetch('/api/warmup', { method: 'POST' });
    } finally {
      const modal = document.getElementById('warmup-modal');
      if (modal) modal.classList.add('hidden');
    }
  })();

  // Settings modal
  (() => {
    const gear = document.getElementById('settings-btn');
    const sModal = document.getElementById('settings-modal');
    const sClose = document.getElementById('settings-close');
    const clearBtn = document.getElementById('clear-db-btn') as HTMLButtonElement | null;
    gear?.addEventListener('click', () => sModal?.classList.remove('hidden'));
    sClose?.addEventListener('click', () => sModal?.classList.add('hidden'));
    sModal?.addEventListener('click', (e) => { if (e.target === sModal) sModal.classList.add('hidden'); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') sModal?.classList.add('hidden'); });
    clearBtn?.addEventListener('click', async () => {
      if (!confirm('Clear database? Corrections, debates, messages, expressions and logs will be deleted. This cannot be undone.')) return;
      clearBtn.disabled = true;
      clearBtn.textContent = 'Clearing...';
      try {
        const res = await fetch('/api/clear-all', { method: 'POST' });
        const data = await res.json();
        if (data.error) alert(data.error);
        else location.reload();
      } catch (e) {
        alert('Error clearing');
      } finally {
        clearBtn.disabled = false;
        clearBtn.textContent = 'Clear database';
        sModal?.classList.add('hidden');
      }
    });
  })();

  // Polling for automatic corrections with incremental updates
  let corrPollingId: ReturnType<typeof setInterval> | null = null;
  let lastCorrectionId = 0;
  let isFirstLoad = true;

  function updateStatusMessage(msg: string) {
    const results = document.getElementById('trace-results');
    if (!results) return;
    let statusEl = results.querySelector('.trace-status') as HTMLElement | null;
    if (!statusEl) {
      statusEl = document.createElement('p');
      statusEl.className = 'trace-status trace-loading';
    }
    statusEl.textContent = msg;
    // Siempre al principio, por delante de .trace-cards
    if (results.firstChild !== statusEl) {
      results.prepend(statusEl);
    }
  }

  function removeStatusMessage() {
    const results = document.getElementById('trace-results');
    if (!results) return;
    const statusEl = results.querySelector('.trace-status');
    if (statusEl) statusEl.remove();
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderCard(corr: any): string {
    const hasTime = corr.processing_ms != null;
    const timeLabel = hasTime ? Math.round(corr.processing_ms / 1000) + 's' : '-';
    return `
        <div class="corr-card" data-id="${corr.id}">
          <div class="corr-header"><span class="corr-time">${timeLabel}</span><span class="corr-tag">${corr.label || corr.code}</span></div>
          <div class="corr-row"><span class="corr-bad">${escapeHtml(corr.original)}</span></div>
          <div class="corr-row"><span class="corr-arrow">â†’</span><span class="corr-good">${escapeHtml(corr.corrected)}</span></div>
        </div>`;
  }

  function renderAllCorrections(corrections: any[]) {
    const results = document.getElementById('trace-results');
    if (!results) return;

    if (!corrections || corrections.length === 0) {
      results.innerHTML = '<p class="trace-empty">Speak to get automatic corrections</p>';
      return;
    }

    let html = '<div class="trace-cards">';
    for (const corr of corrections) {
      html += renderCard(corr);
    }
    html += '</div>';
    results.innerHTML = html;

    // Set lastCorrectionId from loaded data
    let maxId = 0;
    for (const corr of corrections) {
      if (corr.id > maxId) maxId = corr.id;
    }
    if (maxId > lastCorrectionId) lastCorrectionId = maxId;
  }

  function appendNewCorrections(corrections: any[]) {
    if (!corrections || corrections.length === 0) return;

    const results = document.getElementById('trace-results');
    if (!results) return;

    // If container doesn't exist, create it without deleting the status at the top
    let container = results.querySelector('.trace-cards') as HTMLElement | null;
    if (!container) {
      const empty = results.querySelector('.trace-empty');
      if (empty) empty.remove();
      container = document.createElement('div');
      container.className = 'trace-cards';
      const statusEl = results.querySelector('.trace-status');
      if (statusEl) {
        statusEl.after(container);
      } else {
        results.appendChild(container);
      }
    }

    // Corrections arrive oldest-first; prepending each leaves the newest on top (id DESC)
    for (const corr of corrections) {
      const card = document.createElement('div');
      card.innerHTML = renderCard(corr).trim();
      const cardEl = card.firstElementChild as HTMLElement;
      if (cardEl && container) container.prepend(cardEl);
      if (corr.id > lastCorrectionId) lastCorrectionId = corr.id;
    }
  }

  function renderCorrectionsPanel(data: any) {
    const results = document.getElementById('trace-results');
    if (!results) return;

    // Initial load: acepta ambos payloads (corrections o newCorrections)
    if (isFirstLoad) {
      const initial = (data.corrections ?? data.newCorrections ?? []) as any[];
      renderAllCorrections(initial);
      isFirstLoad = false;

      if (data.analyzing && data.queueLength > 0) {
        updateStatusMessage(`Analyzing... (${data.queueLength} in queue)`);
      } else if (data.analyzing) {
        updateStatusMessage('Analyzing your sentence');
      } else {
        removeStatusMessage();
      }
      return;
    }

    // Incremental update: caso normal newCorrections (ASC -> prepend deja DESC)
    if (data.newCorrections && data.newCorrections.length > 0) {
      appendNewCorrections(data.newCorrections);
    } else if (data.corrections && data.corrections.length > 0) {
      // Fallback A-light: backend devolviÃ³ corrections con ?since=0 (ej. DB vacÃ­a al inicio)
      // Filtrar sin flicker: solo nuevos id y ordenar ASC para prepend correcto
      const nuevos = (data.corrections as any[])
        .filter((c: any) => c.id > lastCorrectionId)
        .sort((a: any, b: any) => a.id - b.id);
      if (nuevos.length > 0) appendNewCorrections(nuevos);
    }

    // Update status messages (siempre arriba via prepend)
    if (data.analyzing && data.queueLength > 0) {
      updateStatusMessage(`Analyzing... (${data.queueLength} in queue)`);
    } else if (data.analyzing) {
      updateStatusMessage('Analyzing your sentence');
    } else {
      removeStatusMessage();
    }
  }

  async function pollCorrections() {
    try {
      const res = await fetch(`/api/corrections-status?since=${lastCorrectionId}`);
      const data = await res.json();
      renderCorrectionsPanel(data);
    } catch (e) {
      console.error('[pollCorrections]', e);
    }
  }

  function startCorrectionsPolling() {
    if (corrPollingId) return;
    pollCorrections();
    corrPollingId = setInterval(pollCorrections, 3000);
  }

  startCorrectionsPolling();

  document.getElementById('clear-record')?.addEventListener('click', async () => {
    const btn = document.getElementById('clear-record');
    if (!btn) return;
    btn.disabled = true;
    btn.textContent = 'Clearing...';
    try {
      const res = await fetch('/api/clear-all', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const data = await res.json();
      if (data.error) {
        alert(`Error: ${data.error}`);
      } else {
        const results = document.getElementById('trace-results');
        if (results) results.innerHTML = '<p class="trace-empty">Corrections cleared.</p>';
        lastCorrectionId = 0;
        isFirstLoad = true;
      }
    } catch (e) {
      alert('Error clearing trace.');
    }
    btn.disabled = false;
    btn.textContent = 'Clean trace';
  });

  // Pomodoro timer: 25 min work / 5 min break, with pause/resume
  (() => {
    const WORK_MIN = 25;
    const BREAK_MIN = 5;
    const timeEl = document.getElementById('pomodoro-time');
    const toggleBtn = document.getElementById('pomodoro-toggle');
    const resetBtn = document.getElementById('pomodoro-reset');
    if (!timeEl || !toggleBtn || !resetBtn) return;

    let mode = 'work';
    let remaining = WORK_MIN * 60;
    let running = false;
    let intervalId = null;
    let endTime = 0;
    let ringCtx = null;

    function ensureRingCtx() {
      if (!ringCtx) {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        ringCtx = new Ctx();
      }
      if (ringCtx.state === 'suspended') ringCtx.resume();
      return ringCtx;
    }

    function playRing() {
      try {
        if (!ringCtx) return;
        const ctx = ringCtx;
        const now = ctx.currentTime;
        const notes = [880, 880, 880, 660];
        const step = 0.3;
        const dur = 0.22;
        notes.forEach((freq, i) => {
          const start = now + i * step;
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'square';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, start);
          gain.gain.exponentialRampToValueAtTime(0.25, start + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, start + dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(start);
          osc.stop(start + dur + 0.05);
        });
      } catch (e) {
        console.error('Ring sound error:', e);
      }
    }

    function fmt(totalSeconds) {
      const s = Math.max(0, Math.ceil(totalSeconds));
      return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
    }

    const playIcon = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>';
    const pauseIcon = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>';

    function render() {
      timeEl.textContent = fmt(remaining);
      toggleBtn.innerHTML = running ? pauseIcon : playIcon;
      toggleBtn.setAttribute('aria-label', running ? 'Pause' : 'Start');
      toggleBtn.classList.toggle('active', running);
      toggleBtn.classList.toggle('hidden', remaining === 0);
    }

    function tick() {
      remaining = Math.max(0, (endTime - Date.now()) / 1000);
      if (remaining <= 0) {
        clearInterval(intervalId);
        running = false;
        switchMode();
      }
      render();
    }

    function switchMode() {
      playRing();
      mode = mode === 'work' ? 'break' : 'work';
      remaining = (mode === 'work' ? WORK_MIN : BREAK_MIN) * 60;
      startTimer();
    }

    function startTimer() {
      if (remaining <= 0) return;
      running = true;
      endTime = Date.now() + remaining * 1000;
      clearInterval(intervalId);
      intervalId = setInterval(tick, 200);
      render();
    }

    function pauseTimer() {
      running = false;
      clearInterval(intervalId);
      intervalId = null;
      render();
    }

    function resetTimer() {
      running = false;
      clearInterval(intervalId);
      intervalId = null;
      mode = 'work';
      remaining = WORK_MIN * 60;
      render();
    }

    toggleBtn.addEventListener('click', () => {
      ensureRingCtx();
      if (running) pauseTimer();
      else startTimer();
    });

    resetBtn.addEventListener('click', resetTimer);

    render();
  })();

  // New Expressions panel: load saved expressions as mini cards
  const expressionsList = document.getElementById('expressions-list');
  async function loadExpressions() {
    if (!expressionsList) return;
    try {
      const res = await fetch('/api/expressions');
      const data = await res.json();
      if (data.expressions) {
        if (data.expressions.length === 0) {
          expressionsList.innerHTML = '<p class="expressions-empty">No expressions saved yet</p>';
        } else {
          expressionsList.innerHTML = data.expressions
            .map((e) => `
              <div class="miniTarjeta">
                <span class="miniTarjeta-text">${e.expression}</span>
                <button class="miniTarjeta-check" data-id="${e.id}" title="Mark as learned">âœ”</button>
              </div>`)
            .join('');
        }
      }
    } catch (error) {
      console.error('Error loading expressions:', error);
    }
  }
  loadExpressions();

  // Delete expression on check click
  expressionsList?.addEventListener('click', async (event) => {
    const btn = (event.target as HTMLElement).closest('.miniTarjeta-check');
    if (!btn) return;
    const id = (btn as HTMLElement).dataset.id;
    if (!id) return;
    try {
      await fetch(`/api/expressions/${id}`, { method: 'DELETE' });
      await loadExpressions();
    } catch (error) {
      console.error('Error deleting expression:', error);
    }
  });

  // Custom context menu on any selected text (global, excluye #transcript-modal): add to NewExpressions or translate
  const chatDisplay = document.getElementById('chat');
  const contextMenu = document.getElementById('ctx-menu');
  const translationPopup = document.getElementById('translation-popup');
  const translationContent = document.getElementById('translation-content');
  let contextMenuItem = null;

  function positionPopup(element: HTMLElement, clientX: number, clientY: number) {
    const rect = element.getBoundingClientRect();
    const margin = 8;
    let left = clientX;
    let top = clientY + margin;

    if (left + rect.width > window.innerWidth - margin) {
      left = Math.max(margin, window.innerWidth - rect.width - margin);
    }
    if (top + rect.height > window.innerHeight - margin) {
      top = Math.max(margin, clientY - rect.height - margin);
    }
    element.style.left = `${left}px`;
    element.style.top = `${top}px`;
  }

  document.addEventListener('contextmenu', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('#ctx-menu, #translation-popup, #warmup-modal')) return;
    if (target.closest('#transcript-modal')) return;
    const selection = window.getSelection()?.toString().trim() ?? '';
    if (!selection) return;

    event.preventDefault();
    contextMenuItem = { expression: selection, text: selection, x: event.clientX, y: event.clientY };

    if (contextMenu) {
      contextMenu.style.display = 'block';
      positionPopup(contextMenu, event.clientX, event.clientY);
    }
    hideTranslationPopup();
  });

  function hideContextMenu() {
    if (contextMenu) contextMenu.style.display = 'none';
  }

  function hideTranslationPopup() {
    if (translationPopup) {
      translationPopup.style.display = 'none';
      if (translationContent) translationContent.textContent = '';
    }
  }

  document.addEventListener('click', (event) => {
    hideContextMenu();
    if (
      translationPopup &&
      !translationPopup.contains(event.target as Node) &&
      !(event.target as HTMLElement).closest('#ctx-translate')
    ) {
      hideTranslationPopup();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    hideContextMenu();
    hideTranslationPopup();
  });

  document.getElementById('ctx-add-expression')?.addEventListener('click', async () => {
    if (contextMenu) contextMenu.style.display = 'none';
    if (!contextMenuItem) return;

    try {
      const res = await fetch('/api/expressions/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(contextMenuItem),
      });
      const data = await res.json();
      if (data.error) {
        alert(`Error: ${data.error}`);
      } else {
        await loadExpressions();
      }
    } catch (error) {
      console.error('Error saving expression:', error);
    }
  });

  // Translate selected text to Spanish and show a small cloud popup
  document.getElementById('ctx-translate')?.addEventListener('click', async () => {
    hideContextMenu();
    if (!contextMenuItem || !translationPopup || !translationContent) return;

    const { text, x, y } = contextMenuItem;
    if (!text) return;

    positionPopup(translationPopup, x, y);

    translationPopup.style.display = 'block';
    translationContent.textContent = 'Translatingâ€¦';

    try {
      const res = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      const data = await res.json();
      if (data.error) {
        translationContent.textContent = `Error: ${data.error}`;
      } else if (data.translated) {
        translationContent.textContent = data.translated;
      } else {
        translationContent.textContent = 'Could not translate text.';
      }
    } catch (error) {
      console.error('Error translating text:', error);
      translationContent.textContent = 'Translation connection error.';
    }
  });

  document.getElementById('translation-close')?.addEventListener('click', hideTranslationPopup);
</script>
</Layout>
