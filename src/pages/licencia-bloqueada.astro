---
import { getHWIDExport } from '../lib/license-client';
export const prerender = false;
const hwid = getHWIDExport();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Licencia no activa</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f4f6fb; color: #0f172a; display: flex; align-items: center; justify-content: center; min-height: 100vh; margin: 0; }
    .box { background: #fff; border-radius: 16px; padding: 2rem; max-width: 480px; text-align: center; box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
    h1 { color: #dc2626; margin: 0 0 1rem; }
    p { color: #475569; line-height: 1.5; }
    code { display: block; background: #f1f5f9; padding: 0.75rem; border-radius: 8px; font-family: monospace; word-break: break-all; margin: 1rem 0; font-size: 0.85rem; }
    button { background: #4f46e5; color: #fff; border: none; padding: 0.5rem 1.5rem; border-radius: 8px; cursor: pointer; font-size: 0.9rem; }
    button:hover { background: #4338ca; }
    hr { border: none; border-top: 1px solid #e2e8f0; margin: 1.5rem 0 1rem; }
    .support-title { font-family: monospace; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #64748b; margin: 0 0 0.35rem; }
    .support-line { margin: 0.15rem 0; font-size: 0.9rem; }
    .support-line a { color: #4f46e5; text-decoration: none; }
    .support-line a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="box">
    <h1>Licencia no activa</h1>
    <p>Tu licencia no está activa o ha expirado. Envía el siguiente código al administrador para activarla.</p>
    <code id="hwid">{hwid}</code>
    <button id="copy">Copiar HWID</button>
    <hr />
    <p class="support-title">Equipo de soporte</p>
    <p class="support-line">Jorge Briceño — Ing. Software</p>
<p class="support-line">WhatsApp: <a href="https://wa.me/573177552321" target="_blank" rel="noopener noreferrer">317 755 2321</a></p>
    <button id="testLicBtn" class="gear-btn" aria-label="Probar licencia ahora">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2" fill="none"/>
        <line x1="5" y1="5" x2="20" y2="5"/>
        <line x1="5" y1="7" x2="20" y2="7"/>
        <line x1="5" y1="9" x2="20" y2="9"/>
        <line x1="5" y1="11" x2="20" y2="11"/>
        <line x1="5" y1="13" x2="20" y2="13"/>
        <line x1="5" y1="15" x2="20" y2="15"/>
        <line x1="5" y1="17" x2="20" y2="17"/>
        <line x1="5" y1="19" x2="20" y2="19"/>
      </svg>
      Probar licencia ahora
    </button>
    <pre id="licResult" style="font-family: monospace; white-space: pre-wrap; background: #f1f5f9; padding: 0.75rem; border-radius: 8px; margin-top: 1rem; font-size: 0.85rem; text-align: left; max-height: 200px; overflow: auto;"></pre>
   </div>
  <script>
    document.getElementById('copy')?.addEventListener('click', () => {
      const hwid = document.getElementById('hwid')?.textContent ?? '';
      navigator.clipboard.writeText(hwid);
      const btn = document.getElementById('copy');
      if (btn) btn.textContent = '¡Copiado!';
    });
    document.getElementById('testLicBtn')?.addEventListener('click', async () => {
    const hwid = document.getElementById('hwid')?.textContent?.trim() ?? '';
    const resultEl = document.getElementById('licResult');
    if (!hwid) {
      if (resultEl) resultEl.textContent = 'HWID vacío';
      return;
    }
    if (resultEl) resultEl.textContent = 'Consultando backend…';
    const BACKEND = '/api/license-validate';
    try {
      const res = await fetch(BACKEND, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hwid }),
      });
      const text = await res.text();
      let display = `Status: ${res.status}\n\n${text}`;
      try {
        const data = JSON.parse(text);
        if (res.status >= 400 && data && (data.message || data.name || data.code || data.cause || data.detail || data.backendUrl || data.stack)) {
          const lines: string[] = [`Status: ${res.status}`];
          if (data.error) lines.push(`Error: ${data.error}`);
          if (data.name) lines.push(`name: ${data.name}`);
          if (data.message) lines.push(`message: ${data.message}`);
          if (data.code) lines.push(`code: ${data.code}`);
          if (data.detail) lines.push(`detail: ${data.detail}`);
          if (data.cause) {
            if (data.cause.code) lines.push(`cause.code: ${data.cause.code}`);
            if (data.cause.message) lines.push(`cause.message: ${data.cause.message}`);
          }
          if (data.backendUrl) lines.push(`backendUrl: ${data.backendUrl}`);
          if (data.nodeVersion) lines.push(`nodeVersion: ${data.nodeVersion}`);
          if (data.stack) lines.push(`stack:\n${data.stack}`);
          display = lines.join('\n');
        }
      } catch {
        /* respuesta no JSON: se muestra el texto crudo */
      }
      if (resultEl) {
        resultEl.textContent = display;
      }
    } catch (err) {
      if (resultEl) {
        resultEl.textContent = `Error de red: ${(err as any)?.message || err}`;
      }
    }
  });
  </script>
</body>
</html>
