---
import Layout from '../layouts/Layout.astro';
import DiceRecorder from '../components/DiceRecorder.astro';
---

<Layout title="Dice Roller">
  <main class="app">
    <header class="header">
      <div class="header-main">
        <h2>Dice Roller</h2>
        <p class="subtitle">Roll the 12-sided die and answer the question out loud</p>
      </div>
      <nav class="nav-links nav-toggle">
        <a href="/" class="nav-link">Chat mode</a>
        <a href="/fluency" class="nav-link">Debate mode</a>
        <a href="/dice" class="nav-link active">Dice mode</a>
      </nav>
    </header>

    <div class="main-content">
      <div class="chat-area">
        <section class="dice-card">
          <div class="dice-stage">
            <div id="dice-die" class="die">
              <span id="dice-number" class="die-number">12</span>
              <span class="die-label">D12</span>
            </div>
            <button id="roll-btn" class="roll-btn">Roll the die</button>
          </div>

          <div id="dice-result" class="dice-result hidden">
            <span id="dice-structure-badge" class="structure-badge">Structure</span>
            <p id="dice-question" class="dice-question"></p>
            <button id="dice-listen" class="listen-btn" type="button">&#9654; Listen</button>
          </div>

          <div id="dice-current" data-structure-code="" data-structure-label="" data-question="" hidden></div>
        </section>

        <section class="chat-container">
          <div id="dice-chat" class="chat-display"></div>
        </section>

        <section class="controls">
          <DiceRecorder />
        </section>
      </div>

      <aside class="trace-panel">
        <h3>Automatic corrections</h3>
        <span class="trace-hint">Corrections from your last answer</span>
        <button id="clear-dice" class="clear-btn">Clean corrections</button>
        <div id="dice-trace-results" class="trace-results">
          <p class="trace-empty">Roll the die and answer to get corrections</p>
        </div>
      </aside>
    </div>
  </main>

  <div id="warmup-modal" class="modal-overlay">
    <div class="modal-box">
      <div class="modal-spinner"></div>
      <p>Sending conversation and corrections system prompt to cache...</p>
    </div>
  </div>

  <div id="ctx-menu" class="ctx-menu" style="display:none">
    <button id="ctx-add-expression" class="ctx-item">Save to New Expressions</button>
    <button id="ctx-translate" class="ctx-item">Translate to Spanish</button>
  </div>

  <div id="translation-popup" class="translation-popup" style="display:none">
    <button id="translation-close" class="translation-close" title="Close">×</button>
    <div class="translation-label">Translation</div>
    <div id="translation-content" class="translation-content"></div>
  </div>
</Layout>

<script>
  // Warm up the system prompt cache on page load
  (async () => {
    try {
      await fetch('/api/warmup', { method: 'POST' });
    } finally {
      const modal = document.getElementById('warmup-modal');
      if (modal) modal.classList.add('hidden');
    }
  })();

  // Die roll
  const rollBtn = document.getElementById('roll-btn') as HTMLButtonElement | null;
  const die = document.getElementById('dice-die');
  const numberEl = document.getElementById('dice-number');
  const resultEl = document.getElementById('dice-result');
  const badgeEl = document.getElementById('dice-structure-badge');
  const questionEl = document.getElementById('dice-question');
  const currentEl = document.getElementById('dice-current');
  const diceCard = document.querySelector('.dice-card');
  let rolling = false;

  function showResult(data: any) {
    if (badgeEl) badgeEl.textContent = `${data.label} · die ${data.roll}`;
    if (questionEl) questionEl.textContent = data.question;
    resultEl?.classList.remove('hidden');
    diceCard?.classList.add('compact');
    window.dispatchEvent(new CustomEvent('dice-rolled'));
    if (currentEl) {
      currentEl.dataset.structureCode = data.code ?? '';
      currentEl.dataset.structureLabel = data.label ?? '';
      currentEl.dataset.question = data.question ?? '';
    }
  }

  async function rollDie() {
    if (rolling || !rollBtn) return;
    rolling = true;
    rollBtn.disabled = true;
    resultEl?.classList.add('hidden');
    diceCard?.classList.remove('compact');
    die?.classList.add('rolling');
    resetCorrections();
    const spin = setInterval(() => {
      if (numberEl) numberEl.textContent = String(1 + Math.floor(Math.random() * 12));
    }, 80);
    try {
      const res = await fetch('/api/dice-roll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: '{}',
      });
      const data = await res.json();
      await new Promise((r) => setTimeout(r, 300));
      clearInterval(spin);
      if (numberEl) numberEl.textContent = String(data.roll ?? '?');
      if (data.question) {
        showResult(data);
      } else if (questionEl && resultEl) {
        questionEl.textContent = 'Could not get a question. Try again.';
        resultEl.classList.remove('hidden');
        window.dispatchEvent(new CustomEvent('dice-rolled'));
      }
    } catch (e) {
      clearInterval(spin);
      console.error(e);
      if (questionEl && resultEl) {
        questionEl.textContent = 'Error rolling the die. Try again.';
        resultEl.classList.remove('hidden');
        window.dispatchEvent(new CustomEvent('dice-rolled'));
      }
    } finally {
      die?.classList.remove('rolling');
      rollBtn.disabled = false;
      rolling = false;
    }
  }

  rollBtn?.addEventListener('click', rollDie);

  // Listen to the generated question
  let questionAudio: HTMLAudioElement | null = null;
  document.getElementById('dice-listen')?.addEventListener('click', async (e) => {
    const text = questionEl?.textContent?.trim() ?? '';
    if (!text) return;
    const btn = e.currentTarget as HTMLButtonElement;
    try {
      btn.disabled = true;
      const res = await fetch('/api/tts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      if (!res.ok) throw new Error('TTS failed');
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      if (questionAudio) questionAudio.pause();
      questionAudio = new Audio(url);
      questionAudio.onended = () => { btn.disabled = false; URL.revokeObjectURL(url); };
      await questionAudio.play();
    } catch (err) {
      console.error('TTS error:', err);
      btn.disabled = false;
    }
  });

  // Corrections polling for the current answer
  let dicePollingId: ReturnType<typeof setInterval> | null = null;
  let lastDiceCorrectionId = 0;
  let isFirstDiceLoad = true;
  let currentDiceDebateId: number | null = null;

  function resetCorrections() {
    const results = document.getElementById('dice-trace-results');
    if (results) results.innerHTML = '<p class="trace-empty">Roll the die and answer to get corrections</p>';
    lastDiceCorrectionId = 0;
    isFirstDiceLoad = true;
    currentDiceDebateId = null;
  }

  window.addEventListener('dice-submitted', (event: any) => {
    const debateId = event.detail?.debateId;
    if (!debateId) return;
    currentDiceDebateId = debateId;
    lastDiceCorrectionId = 0;
    isFirstDiceLoad = true;
    const results = document.getElementById('dice-trace-results');
    if (results) results.innerHTML = '<p class="trace-loading">Analyzing your answer...</p>';
  });

  function updateDiceStatus(msg: string) {
    const results = document.getElementById('dice-trace-results');
    if (!results) return;
    let statusEl = results.querySelector('.trace-status') as HTMLElement | null;
    if (!statusEl) {
      statusEl = document.createElement('p');
      statusEl.className = 'trace-status trace-loading';
    }
    statusEl.textContent = msg;
    if (results.firstChild !== statusEl) results.prepend(statusEl);
  }

  function removeDiceStatus() {
    const results = document.getElementById('dice-trace-results');
    if (!results) return;
    const statusEl = results.querySelector('.trace-status');
    if (statusEl) statusEl.remove();
  }

  function renderDiceCard(corr: any): string {
    const hasTime = corr.processing_ms != null;
    const timeLabel = hasTime ? Math.round(corr.processing_ms / 1000) + 's' : '-';
    return `
        <div class="corr-card" data-id="${corr.id}">
          <div class="corr-header"><span class="corr-time">${timeLabel}</span><span class="corr-tag">${corr.label || corr.code}</span></div>
          <div class="corr-row"><span class="corr-bad">${corr.original}</span></div>
          <div class="corr-row"><span class="corr-arrow">→</span><span class="corr-good">${corr.corrected}</span></div>
        </div>`;
  }

  function renderAllDiceCorrections(corrections: any[]) {
    const results = document.getElementById('dice-trace-results');
    if (!results) return;
    if (!corrections || corrections.length === 0) {
      results.innerHTML = '<p class="trace-empty">No errors found in your answer. Great job!</p>';
      return;
    }
    let html = '<div class="trace-cards">';
    for (const corr of corrections) html += renderDiceCard(corr);
    html += '</div>';
    results.innerHTML = html;
    let maxId = 0;
    for (const corr of corrections) if (corr.id > maxId) maxId = corr.id;
    if (maxId > lastDiceCorrectionId) lastDiceCorrectionId = maxId;
  }

  function appendNewDiceCorrections(corrections: any[]) {
    if (!corrections || corrections.length === 0) return;
    const results = document.getElementById('dice-trace-results');
    if (!results) return;
    let container = results.querySelector('.trace-cards') as HTMLElement | null;
    if (!container) {
      const empty = results.querySelector('.trace-empty');
      if (empty) empty.remove();
      container = document.createElement('div');
      container.className = 'trace-cards';
      const statusEl = results.querySelector('.trace-status');
      if (statusEl) statusEl.after(container);
      else results.appendChild(container);
    }
    for (const corr of corrections) {
      const card = document.createElement('div');
      card.innerHTML = renderDiceCard(corr).trim();
      const cardEl = card.firstElementChild as HTMLElement;
      if (cardEl && container) container.prepend(cardEl);
      if (corr.id > lastDiceCorrectionId) lastDiceCorrectionId = corr.id;
    }
  }

  function renderDicePanel(data: any) {
    const results = document.getElementById('dice-trace-results');
    if (!results) return;
    if (!currentDiceDebateId) {
      if (isFirstDiceLoad) {
        renderAllDiceCorrections([]);
        isFirstDiceLoad = false;
        removeDiceStatus();
      }
      return;
    }
    if (isFirstDiceLoad) {
      const initial = (data.corrections ?? data.newCorrections ?? []) as any[];
      const filtered = initial.filter((c: any) => c.debate_id === currentDiceDebateId);
      renderAllDiceCorrections(filtered);
      isFirstDiceLoad = false;
      if (data.analyzing && data.queueLength > 0) updateDiceStatus(`Analyzing... (${data.queueLength} in queue)`);
      else if (data.analyzing) updateDiceStatus('Analyzing your answer');
      else removeDiceStatus();
      return;
    }
    if (data.newCorrections?.length) {
      const nuevos = (data.newCorrections as any[]).filter((c: any) => c.debate_id === currentDiceDebateId);
      if (nuevos.length) appendNewDiceCorrections(nuevos);
    } else if (data.corrections?.length) {
      const nuevos = (data.corrections as any[])
        .filter((c: any) => c.debate_id === currentDiceDebateId && c.id > lastDiceCorrectionId)
        .sort((a: any, b: any) => a.id - b.id);
      if (nuevos.length) appendNewDiceCorrections(nuevos);
    }
    if (data.analyzing && data.queueLength > 0) updateDiceStatus(`Analyzing... (${data.queueLength} in queue)`);
    else if (data.analyzing) updateDiceStatus('Analyzing your answer');
    else removeDiceStatus();
  }

  async function pollDiceCorrections() {
    try {
      if (!currentDiceDebateId) {
        if (isFirstDiceLoad) {
          renderAllDiceCorrections([]);
          isFirstDiceLoad = false;
          removeDiceStatus();
        }
        return;
      }
      const res = await fetch(`/api/fluency-corrections-status?since=${lastDiceCorrectionId}&debateId=${currentDiceDebateId}`);
      const data = await res.json();
      renderDicePanel(data);
    } catch (e) {
      console.error('[pollDice]', e);
    }
  }

  function startDicePolling() {
    if (dicePollingId) return;
    pollDiceCorrections();
    dicePollingId = setInterval(pollDiceCorrections, 3000);
  }

  startDicePolling();

  document.getElementById('clear-dice')?.addEventListener('click', () => {
    resetCorrections();
    const results = document.getElementById('dice-trace-results');
    if (results) results.innerHTML = '<p class="trace-empty">Corrections cleared.</p>';
  });

  // Context menu + translation popup (shared behaviour with other modes)
  const contextMenu = document.getElementById('ctx-menu');
  const translationPopup = document.getElementById('translation-popup');
  const translationContent = document.getElementById('translation-content');
  let contextMenuItem: any = null;

  function positionPopup(element: HTMLElement, clientX: number, clientY: number) {
    const rect = element.getBoundingClientRect();
    const margin = 8;
    let left = clientX;
    let top = clientY + margin;
    if (left + rect.width > window.innerWidth - margin) left = Math.max(margin, window.innerWidth - rect.width - margin);
    if (top + rect.height > window.innerHeight - margin) top = Math.max(margin, clientY - rect.height - margin);
    element.style.left = `${left}px`;
    element.style.top = `${top}px`;
  }

  document.addEventListener('contextmenu', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('#ctx-menu, #translation-popup, #warmup-modal')) return;
    if (target.closest('#dice-transcript-modal')) return;
    const selection = window.getSelection()?.toString().trim() ?? '';
    if (!selection) return;
    event.preventDefault();
    contextMenuItem = { expression: selection, text: selection, x: event.clientX, y: event.clientY };
    if (contextMenu) {
      contextMenu.style.display = 'block';
      positionPopup(contextMenu, event.clientX, event.clientY);
    }
    hideTranslationPopup();
  });

  function hideContextMenu() { if (contextMenu) contextMenu.style.display = 'none'; }
  function hideTranslationPopup() {
    if (translationPopup) {
      translationPopup.style.display = 'none';
      if (translationContent) translationContent.textContent = '';
    }
  }
  document.addEventListener('click', (event) => {
    hideContextMenu();
    if (translationPopup && !translationPopup.contains(event.target as Node) && !(event.target as HTMLElement).closest('#ctx-translate')) hideTranslationPopup();
  });
  document.addEventListener('keydown', (event) => { if (event.key !== 'Escape') return; hideContextMenu(); hideTranslationPopup(); });

  document.getElementById('ctx-add-expression')?.addEventListener('click', async () => {
    hideContextMenu();
    if (!contextMenuItem) return;
    try {
      const res = await fetch('/api/expressions/add', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(contextMenuItem),
      });
      const data = await res.json();
      if (data.error) alert(`Error: ${data.error}`);
    } catch (e) { console.error(e); }
  });

  document.getElementById('ctx-translate')?.addEventListener('click', async () => {
    hideContextMenu();
    if (!contextMenuItem || !translationPopup || !translationContent) return;
    const { text, x, y } = contextMenuItem;
    if (!text) return;
    positionPopup(translationPopup, x, y);
    translationPopup.style.display = 'block';
    translationContent.textContent = 'Translating…';
    try {
      const res = await fetch('/api/translate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text }),
      });
      const data = await res.json();
      if (data.error) translationContent.textContent = `Error: ${data.error}`;
      else if (data.translated) translationContent.textContent = data.translated;
      else translationContent.textContent = 'Could not translate text.';
    } catch (e) { console.error(e); translationContent.textContent = 'Translation connection error.'; }
  });

  document.getElementById('translation-close')?.addEventListener('click', hideTranslationPopup);
</script>


<style is:global>
  .dice-card { background: var(--surface-2); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem; border-left: 3px solid var(--accent); display: flex; flex-direction: column; gap: 0.75rem; align-items: center; transition: padding 0.25s ease, gap 0.25s ease, margin 0.25s ease; }
  .dice-stage { display: flex; flex-direction: column; align-items: center; gap: 0.85rem; }
  .die { width: 120px; height: 120px; display: grid; place-items: center; grid-template-rows: auto auto; background: linear-gradient(135deg, var(--accent), var(--accent-2)); clip-path: polygon(50% 0%, 75% 6.7%, 93.3% 25%, 100% 50%, 93.3% 75%, 75% 93.3%, 50% 100%, 25% 93.3%, 6.7% 75%, 0% 50%, 6.7% 25%, 25% 6.7%); filter: drop-shadow(0 8px 20px var(--accent-glow)); transition: width 0.25s ease, height 0.25s ease; }
  .die.rolling { animation: diceRoll 0.3s ease-in-out; }
  @keyframes diceRoll { 0% { transform: rotate(0deg) scale(1); } 50% { transform: rotate(360deg) scale(1.12); } 100% { transform: rotate(720deg) scale(1); } }
  .die-number { font-size: 2.6rem; font-weight: 800; color: #fff; line-height: 1; transition: font-size 0.25s ease; }
  .die-label { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; letter-spacing: 1px; color: rgba(255,255,255,0.85); transition: font-size 0.25s ease; }
  .roll-btn { padding: 0.6rem 1.4rem; border: none; border-radius: var(--radius-sm); background: var(--accent); color: var(--on-accent); font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: background 0.2s, transform 0.2s, box-shadow 0.2s; box-shadow: 0 4px 14px var(--accent-glow); }
  .roll-btn:hover:not(:disabled) { background: var(--accent-hover); transform: translateY(-1px); box-shadow: 0 6px 18px var(--accent-glow); }
  .roll-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .dice-result { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 0.6rem; text-align: center; animation: fadeIn 0.3s ease-out; }
  .dice-result.hidden { display: none; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .structure-badge { display: inline-block; font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); background: var(--accent-soft); border: 1px solid var(--border-muted); padding: 0.3rem 0.7rem; border-radius: 999px; }
  .dice-question { font-size: 1.05rem; line-height: 1.5; color: var(--text); max-width: 640px; min-height: 1.5rem; }
  .listen-btn { padding: 0.35rem 0.9rem; border: 1px solid var(--border-muted); border-radius: 999px; background: transparent; color: var(--text-muted); font-size: 0.8rem; cursor: pointer; transition: border-color 0.15s, color 0.15s, background 0.15s; }
  .listen-btn:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }
  .listen-btn:disabled { opacity: 0.6; cursor: not-allowed; }

  .dice-card.compact { flex-direction: row; align-items: center; gap: 0.75rem; padding: 0.55rem 0.85rem; margin-bottom: 0.5rem; }
  .dice-card.compact .dice-stage { gap: 0.35rem; }
  .dice-card.compact .die { width: 56px; height: 56px; }
  .dice-card.compact .die-number { font-size: 1.4rem; }
  .dice-card.compact .die-label { font-size: 0.55rem; letter-spacing: 0.5px; }
  .dice-card.compact .roll-btn { padding: 0.3rem 0.7rem; font-size: 0.75rem; }
  .dice-card.compact .dice-result { flex: 1; min-width: 0; align-items: flex-start; text-align: left; gap: 0.3rem; }
  .dice-card.compact .dice-question { font-size: 0.95rem; }
  .dice-card.compact .listen-btn { padding: 0.25rem 0.7rem; font-size: 0.75rem; }

  .message.suggestions .content { background: var(--accent-soft); border: 1px solid var(--border-muted); color: var(--text); max-width: 85%; }
  .suggestions-title { font-weight: 600; font-size: 0.8rem; color: var(--accent); margin: 0 0 0.25rem; }
  .suggestions-list { margin: 0; padding-left: 1.1rem; }
  .suggestions-list li { margin: 0.15rem 0; font-size: 0.85rem; line-height: 1.4; }
</style>